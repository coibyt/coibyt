    "blocks": [
      {
        "kind": "text",
        "text": "Biết giá trị của n/d một số: lấy giá trị đó chia cho n để được một phần, rồi nhân với d.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Hai bạn Dũng và Ngọc có tất cả 4.860 viên bi. Số bi của Ngọc gấp 2 lần số bi của Dũng. Hỏi Ngọc có bao nhiêu viên bi?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Coi số bi của Dũng là 1 phần thì số bi của Ngọc là 2 phần như thế. Tổng số phần bằng nhau là:",
            "equation": "1 + 2 = 3 (phần)"
          },
          {
            "explanation": "Giá trị của một phần (số bi của Dũng) là:",
            "equation": "4.860 : 3 = 1.620 (viên)"
          },
          {
            "explanation": "Số bi của Ngọc là:",
            "equation": "1.620 × 2 = 3.240 (viên)"
          }
        ],
        "answer": "Đáp số: 3.240 viên bi."
      }
    ]
  },
