  "theory": {
    "title": "Nhớ nhanh",
    "blocks": [
      {
        "kind": "text",
        "text": "Góc nhọn bé hơn góc vuông. Góc tù lớn hơn góc vuông nhưng bé hơn góc bẹt. Góc bẹt bằng hai góc vuông, tức là 180°.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: 45° là góc nhọn; 90° là góc vuông; 120° là góc tù; 180° là góc bẹt."
      },
      {
        "kind": "text",
        "text": "Mẹo: kim đồng hồ lúc 3 giờ tạo góc vuông, lúc 6 giờ tạo góc bẹt.",
        "style": "tip"
      }
    ]
  },
