      },
      {
        "kind": "text",
        "text": "Góc nhọn bé hơn góc vuông; góc tù lớn hơn góc vuông nhưng bé hơn góc bẹt."
      },
      {
        "kind": "text",
        "text": "Hình bình hành có từng cặp cạnh đối diện song song và bằng nhau; hình thoi có bốn cạnh bằng nhau."
      },
      {
        "kind": "text",
        "text": "Dùng thước đo góc để đo góc, dùng ê ke để vẽ góc vuông.",
        "style": "tip"
      }
    ]
  },
