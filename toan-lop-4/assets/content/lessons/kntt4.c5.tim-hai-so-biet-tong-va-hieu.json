    "blocks": [
      {
        "kind": "text",
        "text": "Số lớn bằng tổng cộng hiệu rồi chia cho hai; số bé bằng tổng trừ hiệu rồi chia cho hai.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: tổng 70, hiệu 10."
      },
      {
        "kind": "equation",
        "text": "(70 + 10) : 2 = 40"
      },
      {
        "kind": "equation",
        "text": "70 - 40 = 30"
      },
      {
        "kind": "text",
        "text": "Số lớn 40, số bé 30."
      },
      {
        "kind": "text",
        "text": "Thử lại: số lớn + số bé = tổng; số lớn - số bé = hiệu.",
        "style": "tip"
      }
    ]
  },
