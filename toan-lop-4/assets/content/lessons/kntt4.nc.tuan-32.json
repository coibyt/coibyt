      },
      {
        "kind": "text",
        "text": "Ví dụ: Trung bình cộng của 3 số là 39. Biết 2 số trong đó là 37, 27. Tìm số còn lại."
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Tổng của các số là:",
            "equation": "39 × 3 = 117"
          },
          {
            "explanation": "Số còn lại là:",
            "equation": "117 - 37 - 27 = 53"
          }
        ],
        "answer": "Đáp số: 53."
      }
    ]
