    "blocks": [
      {
        "kind": "text",
        "text": "Biểu đồ cột biểu diễn số liệu bằng các cột: cột càng cao thì số liệu càng lớn. Số ghi trên đỉnh mỗi cột cho biết số liệu của cột đó.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Đọc biểu đồ: đọc tên biểu đồ, tên các cột, rồi số liệu của từng cột."
      },
      {
        "kind": "text",
        "text": "Ví dụ: cột 4B ghi 45 quyển, cột 4A ghi 30 quyển. Lớp 4B góp nhiều hơn lớp 4A:"
      },
      {
        "kind": "equation",
        "text": "45 - 30 = 15"
      },
      {
        "kind": "text",
        "text": "Con nhìn đỉnh của từng cột rồi đọc số ghi trên cột đó nhé.",
        "style": "tip"
      }
    ]
  },
