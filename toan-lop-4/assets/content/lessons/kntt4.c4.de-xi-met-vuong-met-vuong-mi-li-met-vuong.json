  "theory": {
    "title": "Nhớ nhanh",
    "blocks": [
      {
        "kind": "text",
        "text": "Đề-xi-mét vuông (dm²) là diện tích hình vuông cạnh 1 dm; mét vuông (m²) là diện tích hình vuông cạnh 1 m; mi-li-mét vuông (mm²) là diện tích hình vuông cạnh 1 mm.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "1 m² = 100 dm²; 1 dm² = 100 cm²; 1 cm² = 100 mm²."
      },
      {
        "kind": "text",
        "text": "Ví dụ: 5 m² = 500 dm²."
      },
      {
        "kind": "text",
        "text": "Hai đơn vị đo diện tích liền nhau hơn kém nhau một trăm lần, ví dụ một mét vuông bằng một trăm đề-xi-mét vuông.",
        "style": "tip"
      }
    ]
  },
