    "blocks": [
      {
        "kind": "text",
        "text": "Tìm hai số biết tổng và hiệu: số lớn = (tổng + hiệu) : 2, số bé = (tổng - hiệu) : 2. Có khi đề giấu tổng hoặc hiệu trong câu chữ.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Tổng của hai số là số lớn nhất có ba chữ số, hiệu của chúng là số lớn nhất có ba chữ số mà chữ số hàng trăm là 1. Tìm số lớn."
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Tổng hai số là 999, hiệu hai số là:",
            "equation": "199 = 199"
          },
          {
            "explanation": "Số lớn là:",
            "equation": "(999 + 199) : 2 = 599"
          }
        ],
        "answer": "Đáp số: 599."
      }
    ]
  },
