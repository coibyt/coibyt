  "theory": {
    "title": "Bí kíp nâng cao",
    "blocks": [
      {
        "kind": "text",
        "text": "Số trung bình cộng × số các số = tổng các số. Bài rút về đơn vị: tìm giá trị một phần trước.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Nhà trường mua 42 bộ bàn ghế, mỗi bộ giá 42.000 đồng và 29 bảng tên, mỗi chiếc giá 19.000 đồng. Hỏi nhà trường phải trả tất cả bao nhiêu tiền?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Tiền mua bàn ghế là:",
            "equation": "42.000 × 42 = 1.764.000 (đồng)"
          },
          {
            "explanation": "Tiền mua bảng tên là:",
            "equation": "19.000 × 29 = 551.000 (đồng)"
          },
          {
            "explanation": "Nhà trường phải trả tất cả là:",
            "equation": "1.764.000 + 551.000 = 2.315.000 (đồng)"
          }
        ],
        "answer": "Đáp số: 2.315.000 đồng."
      }
    ]
  },
