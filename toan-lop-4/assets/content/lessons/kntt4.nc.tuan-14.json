    "title": "Bí kíp nâng cao",
    "blocks": [
      {
        "kind": "text",
        "text": "Hình chữ nhật: nửa chu vi = chiều dài + chiều rộng. Hình bình hành, hình thoi có các cặp cạnh đối diện bằng nhau.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Một hình chữ nhật có chu vi 22 cm, chiều dài hơn chiều rộng 3 cm. Tính diện tích hình chữ nhật đó."
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Nửa chu vi (chiều dài cộng chiều rộng) là:",
            "equation": "22 : 2 = 11 (cm)"
          },
          {
            "explanation": "Hai lần chiều rộng là:",
            "equation": "11 - 3 = 8 (cm)"
          },
          {
            "explanation": "Chiều rộng hình chữ nhật là:",
            "equation": "8 : 2 = 4 (cm)"
          },
          {
            "explanation": "Chiều dài hình chữ nhật là:",
            "equation": "4 + 3 = 7 (cm)"
          },
          {
            "explanation": "Diện tích hình chữ nhật là:",
            "equation": "7 × 4 = 28 (cm²)"
          }
        ],
        "answer": "Đáp số: 28 cm²."
      }
    ]
  },
