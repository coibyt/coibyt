  "title": "Nâng cao tuần 22: Nhân, chia, trung bình cộng",
  "contentRev": 1,
  "theory": {
    "title": "Bí kíp nâng cao",
    "blocks": [
      {
        "kind": "text",
        "text": "Số trung bình cộng × số các số = tổng các số. Bài rút về đơn vị: tìm giá trị một phần trước.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Có 198 học sinh đi tham quan. Mỗi xe chở được 28 học sinh. Hỏi cần ít nhất bao nhiêu xe để chở hết số học sinh?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "7 xe chở đầy được:",
            "equation": "28 × 7 = 196 (học sinh)"
          },
          {
            "explanation": "Số học sinh còn lại là:",
            "equation": "198 - 196 = 2 (học sinh)"
          },
          {
            "explanation": "Cần thêm một xe cho số học sinh còn lại. Số xe cần ít nhất là:",
            "equation": "7 + 1 = 8 (xe)"
          }
        ],
        "answer": "Đáp số: 8 xe."
      }
    ]
  },
