  "theory": {
    "title": "Bí kíp nâng cao",
    "blocks": [
      {
        "kind": "text",
        "text": "Các góc ghép lại thành góc bẹt có tổng số đo 180°, thành góc vuông có tổng 90°.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Bể thứ nhất có 24.400 l nước. Bể thứ hai có nhiều hơn bể thứ nhất 4.700 l. Bể thứ ba có ít hơn bể thứ hai 10.700 l. Hỏi cả ba bể có bao nhiêu lít nước?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Số nước ở bể thứ hai là:",
            "equation": "24.400 + 4.700 = 29.100 (l)"
          },
          {
            "explanation": "Số nước ở bể thứ ba là:",
            "equation": "29.100 - 10.700 = 18.400 (l)"
          },
          {
            "explanation": "Số nước ở cả ba bể là:",
            "equation": "24.400 + 29.100 + 18.400 = 71.900 (l)"
          }
        ],
        "answer": "Đáp số: 71.900 l nước."
      }
    ]
  },
