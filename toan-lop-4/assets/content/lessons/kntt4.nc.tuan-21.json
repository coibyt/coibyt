    "blocks": [
      {
        "kind": "text",
        "text": "Số trung bình cộng × số các số = tổng các số. Bài rút về đơn vị: tìm giá trị một phần trước.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Có 93 học sinh đi tham quan. Mỗi xe chở được 26 học sinh. Hỏi cần ít nhất bao nhiêu xe để chở hết số học sinh?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "3 xe chở đầy được:",
            "equation": "26 × 3 = 78 (học sinh)"
          },
          {
            "explanation": "Số học sinh còn lại là:",
            "equation": "93 - 78 = 15 (học sinh)"
          },
          {
            "explanation": "Cần thêm một xe cho số học sinh còn lại. Số xe cần ít nhất là:",
            "equation": "3 + 1 = 4 (xe)"
          }
        ],
        "answer": "Đáp số: 4 xe."
      }
    ]
  },
