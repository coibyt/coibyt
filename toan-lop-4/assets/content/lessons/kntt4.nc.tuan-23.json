  "theory": {
    "title": "Bí kíp nâng cao",
    "blocks": [
      {
        "kind": "text",
        "text": "Số trung bình cộng × số các số = tổng các số. Bài rút về đơn vị: tìm giá trị một phần trước.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Có 133 học sinh đi tham quan. Mỗi xe chở được 16 học sinh. Hỏi cần ít nhất bao nhiêu xe để chở hết số học sinh?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "8 xe chở đầy được:",
            "equation": "16 × 8 = 128 (học sinh)"
          },
          {
            "explanation": "Số học sinh còn lại là:",
            "equation": "133 - 128 = 5 (học sinh)"
          },
          {
            "explanation": "Cần thêm một xe cho số học sinh còn lại. Số xe cần ít nhất là:",
            "equation": "8 + 1 = 9 (xe)"
          }
        ],
        "answer": "Đáp số: 9 xe."
      }
    ]
  },
