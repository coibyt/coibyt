    "blocks": [
      {
        "kind": "text",
        "text": "Ôn tập học kì 1: số lớn, cộng trừ, tổng – hiệu, hình học và đo lường.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Kho thứ nhất có 24.400 kg thóc. Kho thứ hai có nhiều hơn kho thứ nhất 3.400 kg. Kho thứ ba có ít hơn kho thứ hai 7.000 kg. Hỏi cả ba kho có bao nhiêu ki-lô-gam thóc?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Số thóc ở kho thứ hai là:",
            "equation": "24.400 + 3.400 = 27.800 (kg)"
          },
          {
            "explanation": "Số thóc ở kho thứ ba là:",
            "equation": "27.800 - 7.000 = 20.800 (kg)"
          },
          {
            "explanation": "Số thóc ở cả ba kho là:",
            "equation": "24.400 + 27.800 + 20.800 = 73.000 (kg)"
          }
        ],
        "answer": "Đáp số: 73.000 kg thóc."
      }
    ]
  },
