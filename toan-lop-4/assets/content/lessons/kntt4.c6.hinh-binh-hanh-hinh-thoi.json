      {
        "kind": "text",
        "text": "Hình bình hành có hai cặp cạnh đối diện song song và bằng nhau. Hình thoi có hai cặp cạnh đối diện song song và bốn cạnh bằng nhau.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Chu vi hình bình hành = (cạnh dài + cạnh ngắn) × 2."
      },
      {
        "kind": "text",
        "text": "Chu vi hình thoi = độ dài một cạnh × 4."
      },
      {
        "kind": "text",
        "text": "Hình bình hành có từng cặp cạnh đối diện song song và bằng nhau; hình thoi có bốn cạnh bằng nhau.",
        "style": "tip"
      }
    ]
  },
