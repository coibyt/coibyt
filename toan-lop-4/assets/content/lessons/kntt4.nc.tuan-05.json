  "contentRev": 1,
  "theory": {
    "title": "Bí kíp nâng cao",
    "blocks": [
      {
        "kind": "text",
        "text": "Giá trị của một chữ số phụ thuộc vào hàng của nó: cùng là chữ số 5 nhưng ở hàng triệu thì có giá trị 5.000.000.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Hai kho có tất cả 1.680 kg gạo. Số gạo ở kho thứ hai gấp 5 lần số gạo ở kho thứ nhất. Hỏi kho thứ hai có bao nhiêu ki-lô-gam gạo?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Coi số gạo ở kho thứ nhất là 1 phần thì số gạo ở kho thứ hai là 5 phần như thế. Tổng số phần bằng nhau là:",
            "equation": "1 + 5 = 6 (phần)"
          },
          {
            "explanation": "Giá trị của một phần (số gạo ở kho thứ nhất) là:",
            "equation": "1.680 : 6 = 280 (kg)"
          },
          {
            "explanation": "Số gạo ở kho thứ hai là:",
            "equation": "280 × 5 = 1.400 (kg)"
          }
        ],
        "answer": "Đáp số: 1.400 kg gạo."
      }
    ]
  },
