    "blocks": [
      {
        "kind": "text",
        "text": "Bài toán nhiều bước: tóm tắt đề, tìm lần lượt từng số trung gian; con có thể dùng sơ đồ đoạn thẳng để thấy rõ quan hệ giữa các số.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Rổ thứ nhất có 300 quả cam, rổ thứ hai có 296 quả cam. Phải chuyển bao nhiêu quả cam từ rổ thứ nhất sang rổ thứ hai để số quả cam ở hai rổ bằng nhau?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Rổ thứ nhất nhiều hơn rổ thứ hai số quả cam là:",
            "equation": "300 - 296 = 4 (quả)"
          },
          {
            "explanation": "Số quả cam cần chuyển là:",
            "equation": "4 : 2 = 2 (quả)"
          }
        ],
        "answer": "Đáp số: 2 quả cam."
      }
    ]
  },
