  "contentRev": 1,
  "theory": {
    "title": "Bí kíp nâng cao",
    "blocks": [
      {
        "kind": "text",
        "text": "Ôn tập cuối năm: số tự nhiên, phân số, hình học, đo lường, thống kê.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Một mảnh vườn hình chữ nhật có chu vi 44 m, chiều dài hơn chiều rộng 8 m. Tính diện tích mảnh vườn."
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Nửa chu vi là:",
            "equation": "44 : 2 = 22 (m)"
          },
          {
            "explanation": "Chiều dài là:",
            "equation": "(22 + 8) : 2 = 15 (m)"
          },
          {
            "explanation": "Chiều rộng là:",
            "equation": "22 - 15 = 7 (m)"
          },
          {
            "explanation": "Diện tích mảnh vườn là:",
            "equation": "15 × 7 = 105 (m²)"
          }
        ],
        "answer": "Đáp số: 105 m²."
      }
    ]
  },
