  "title": "Biểu thức chứa chữ",
  "contentRev": 1,
  "theory": {
    "title": "Nhớ nhanh",
    "blocks": [
      {
        "kind": "text",
        "text": "Biểu thức chứa chữ là biểu thức có chữ, ví dụ a + b, (a + b) × 2. Mỗi lần thay chữ bằng số ta tính được một giá trị của biểu thức.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: với a = 15, b = 7 thì a + b × 2 = 15 + 7 × 2 = 15 + 14 = 29."
      },
      {
        "kind": "text",
        "text": "Thay số xong, nhớ làm nhân, chia trước; cộng, trừ sau.",
        "style": "tip"
      }
    ]
  },
