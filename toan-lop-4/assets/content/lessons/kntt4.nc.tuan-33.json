      "solution": {
        "access": "free",
        "answerText": "320 m²",
        "hint": "Con tìm tổng và hiệu trước (có khi đề giấu chúng trong câu chữ), rồi mới tìm hai số.",
        "steps": [
          {
            "kind": "word_problem",
            "lines": [
              {
                "explanation": "Nửa chu vi là:",
                "equation": "72 : 2 = 36 (m)"
              },
              {
                "explanation": "Chiều dài là:",
                "equation": "(36 + 4) : 2 = 20 (m)"
              },
              {
                "explanation": "Chiều rộng là:",
                "equation": "36 - 20 = 16 (m)"
              },
              {
                "explanation": "Diện tích mảnh vườn là:",
                "equation": "20 × 16 = 320 (m²)"
              }
            ],
            "answer": "Đáp số: 320 m²."
          }
        ]
      }
    },
