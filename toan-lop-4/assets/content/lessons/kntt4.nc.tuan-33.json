    "blocks": [
      {
        "kind": "text",
        "text": "Ôn tập cuối năm: số tự nhiên, phân số, hình học, đo lường, thống kê.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Trung bình cộng của 3 số là 39. Biết 2 số trong đó là 19, 36. Tìm số còn lại."
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Tổng của các số là:",
            "equation": "39 × 3 = 117"
          },
          {
            "explanation": "Số còn lại là:",
            "equation": "117 - 19 - 36 = 62"
          }
        ],
        "answer": "Đáp số: 62."
      }
    ]
  },
