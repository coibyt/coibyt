      "prompt": {
        "text": "Một mảnh vườn hình chữ nhật có chu vi 72 m, chiều dài hơn chiều rộng 4 m. Tính diện tích mảnh vườn."
      },
      "level": 3,
      "estimatedSeconds": 180,
      "skillIds": [
        "tong_hieu",
        "giai_toan.nhieu_buoc"
      ],
      "access": "free",
      "choices": [
        {
