  "theory": {
    "title": "Bí kíp nâng cao",
    "blocks": [
      {
        "kind": "text",
        "text": "Tìm hai số biết tổng và hiệu: số lớn = (tổng + hiệu) : 2, số bé = (tổng - hiệu) : 2. Có khi đề giấu tổng hoặc hiệu trong câu chữ.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Một mảnh vườn hình chữ nhật có chu vi 58 m, chiều dài hơn chiều rộng 13 m. Tính diện tích mảnh vườn."
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Nửa chu vi là:",
            "equation": "58 : 2 = 29 (m)"
          },
          {
            "explanation": "Chiều dài là:",
            "equation": "(29 + 13) : 2 = 21 (m)"
          },
          {
            "explanation": "Chiều rộng là:",
            "equation": "29 - 21 = 8 (m)"
          },
          {
            "explanation": "Diện tích mảnh vườn là:",
            "equation": "21 × 8 = 168 (m²)"
          }
        ],
        "answer": "Đáp số: 168 m²."
      }
    ]
  },
