    "blocks": [
      {
        "kind": "text",
        "text": "Giải bài toán có ba bước tính: đọc kỹ đề, tìm cái đã cho và cái phải tìm; lần lượt tính các số trung gian rồi mới tính kết quả.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Mua 3 quyển vở giá 8.000 đồng mỗi quyển và 2 bút giá 5.000 đồng mỗi chiếc, đưa 50.000 đồng."
      },
      {
        "kind": "equation",
        "text": "8.000 × 3 = 24.000"
      },
      {
        "kind": "equation",
        "text": "5.000 × 2 = 10.000"
      },
      {
        "kind": "equation",
        "text": "50.000 - 24.000 - 10.000 = 16.000"
      },
      {
        "kind": "text",
        "text": "Viết câu lời giải cho từng bước, cuối cùng ghi đáp số.",
        "style": "tip"
      }
    ]
  },
