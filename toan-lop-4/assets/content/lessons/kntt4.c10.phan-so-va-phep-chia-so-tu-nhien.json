      {
        "kind": "text",
        "text": "Thương của phép chia số tự nhiên cho số tự nhiên khác không có thể viết thành phân số: tử số là số bị chia, mẫu số là số chia.",
        "style": "rule"
      },
      {
        "kind": "equation",
        "text": "3 : 4 = 3/4"
      },
      {
        "kind": "equation",
        "text": "8 : 2 = 8/2 = 4"
      },
      {
        "kind": "text",
        "text": "Mọi số tự nhiên viết được thành phân số có mẫu số là 1, ví dụ 5 = 5/1."
      },
      {
        "kind": "text",
        "text": "Phân số có tử số bằng mẫu số thì bằng 1.",
        "style": "tip"
      }
    ]
  },
