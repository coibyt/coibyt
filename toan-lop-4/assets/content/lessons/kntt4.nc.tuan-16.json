  "contentRev": 1,
  "theory": {
    "title": "Bí kíp nâng cao",
    "blocks": [
      {
        "kind": "text",
        "text": "Hình chữ nhật: nửa chu vi = chiều dài + chiều rộng. Hình bình hành, hình thoi có các cặp cạnh đối diện bằng nhau.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Một mảnh vườn hình chữ nhật có chu vi 130 m, chiều dài hơn chiều rộng 9 m. Tính diện tích mảnh vườn."
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Nửa chu vi là:",
            "equation": "130 : 2 = 65 (m)"
          },
          {
            "explanation": "Chiều dài là:",
            "equation": "(65 + 9) : 2 = 37 (m)"
          },
          {
            "explanation": "Chiều rộng là:",
            "equation": "65 - 37 = 28 (m)"
          },
          {
            "explanation": "Diện tích mảnh vườn là:",
            "equation": "37 × 28 = 1.036 (m²)"
          }
        ],
        "answer": "Đáp số: 1.036 m²."
      }
    ]
  },
