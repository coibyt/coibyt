  "title": "Yến, tạ, tấn",
  "contentRev": 1,
  "theory": {
    "title": "Nhớ nhanh",
    "blocks": [
      {
        "kind": "text",
        "text": "Để đo khối lượng các vật nặng hàng chục, hàng trăm, hàng nghìn ki-lô-gam, người ta dùng yến, tạ, tấn: 1 yến = 10 kg; 1 tạ = 100 kg; 1 tấn = 1.000 kg.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "1 tạ = 10 yến; 1 tấn = 10 tạ."
      },
      {
        "kind": "text",
        "text": "Ví dụ: 3 tạ = 300 kg."
      },
      {
        "kind": "text",
        "text": "Mẹo: yến – mười, tạ – trăm, tấn – nghìn (ki-lô-gam).",
        "style": "tip"
      }
    ]
  },
