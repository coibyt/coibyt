      {
        "kind": "text",
        "text": "Hình chữ nhật: nửa chu vi = chiều dài + chiều rộng. Hình bình hành, hình thoi có các cặp cạnh đối diện bằng nhau.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Một miếng bìa gồm một hình chữ nhật dài 18 cm, rộng 7 cm và một hình vuông cạnh 5 cm ghép sát nhau (không chồng lên nhau). Tính diện tích miếng bìa."
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Diện tích hình chữ nhật là:",
            "equation": "18 × 7 = 126 (cm²)"
          },
          {
            "explanation": "Diện tích hình vuông là:",
            "equation": "5 × 5 = 25 (cm²)"
          },
          {
            "explanation": "Diện tích miếng bìa là:",
            "equation": "126 + 25 = 151 (cm²)"
          }
        ],
        "answer": "Đáp số: 151 cm²."
      }
    ]
  },
