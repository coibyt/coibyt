    {
      "id": "kntt4.nc.tuan-34.p03",
      "rev": 1,
      "type": "multiple_choice",
      "instruction": "Chọn đáp án đúng.",
      "prompt": {
        "text": "Một mảnh vườn hình chữ nhật có chu vi 144 m, chiều dài hơn chiều rộng 16 m. Tính diện tích mảnh vườn."
      },
      "level": 3,
      "estimatedSeconds": 180,
      "skillIds": [
        "tong_hieu",
        "giai_toan.nhieu_buoc"
      ],
      "access": "free",
      "choices": [
        {
          "id": "a",
          "text": "144 m²"
        },
        {
          "id": "b",
          "text": "1.233 m²"
        },
        {
          "id": "c",
          "text": "1.276 m²"
        },
        {
          "id": "d",
          "text": "1.232 m²"
        }
      ],
      "correctChoiceIds": [
        "d"
      ],
      "solution": {
        "access": "free",
        "answerText": "1.232 m²",
        "hint": "Con tìm tổng và hiệu trước (có khi đề giấu chúng trong câu chữ), rồi mới tìm hai số.",
        "steps": [
          {
            "kind": "word_problem",
            "lines": [
              {
                "explanation": "Nửa chu vi là:",
                "equation": "144 : 2 = 72 (m)"
              },
              {
                "explanation": "Chiều dài là:",
                "equation": "(72 + 16) : 2 = 44 (m)"
              },
              {
                "explanation": "Chiều rộng là:",
                "equation": "72 - 44 = 28 (m)"
              },
              {
                "explanation": "Diện tích mảnh vườn là:",
                "equation": "44 × 28 = 1.232 (m²)"
              }
            ],
            "answer": "Đáp số: 1.232 m²."
          }
        ]
      }
    },
