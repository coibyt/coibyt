    "blocks": [
      {
        "kind": "text",
        "text": "Ôn tập cuối năm: số tự nhiên, phân số, hình học, đo lường, thống kê.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Trung bình cộng của 3 số là 42. Biết 2 số trong đó là 29, 22. Tìm số còn lại."
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Tổng của các số là:",
            "equation": "42 × 3 = 126"
          },
          {
            "explanation": "Số còn lại là:",
            "equation": "126 - 29 - 22 = 75"
          }
        ],
        "answer": "Đáp số: 75."
      }
    ]
  },
