  "contentRev": 1,
  "theory": {
    "title": "Bí kíp nâng cao",
    "blocks": [
      {
        "kind": "text",
        "text": "Bài toán nhiều bước: tóm tắt đề, tìm lần lượt từng số trung gian; con có thể dùng sơ đồ đoạn thẳng để thấy rõ quan hệ giữa các số.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Cửa hàng có 8 hộp bút, mỗi hộp 23 chiếc. Buổi sáng cửa hàng bán được 5 hộp và thêm 11 chiếc lẻ. Hỏi cửa hàng còn lại bao nhiêu chiếc bút?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Cửa hàng có số bút là:",
            "equation": "23 × 8 = 184 (chiếc)"
          },
          {
            "explanation": "Buổi sáng bán được số bút là:",
            "equation": "23 × 5 + 11 = 126 (chiếc)"
          },
          {
            "explanation": "Cửa hàng còn lại số bút là:",
            "equation": "184 - 126 = 58 (chiếc)"
          }
        ],
        "answer": "Đáp số: 58 chiếc bút."
      }
    ]
  },
