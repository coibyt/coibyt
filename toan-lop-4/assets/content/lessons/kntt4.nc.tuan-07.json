    "blocks": [
      {
        "kind": "text",
        "text": "Giá trị của một chữ số phụ thuộc vào hàng của nó: cùng là chữ số 5 nhưng ở hàng triệu thì có giá trị 5.000.000.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Bể thứ nhất có 20.200 l nước. Bể thứ hai có nhiều hơn bể thứ nhất 10.000 l. Bể thứ ba có ít hơn bể thứ hai 4.400 l. Hỏi cả ba bể có bao nhiêu lít nước?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Số nước ở bể thứ hai là:",
            "equation": "20.200 + 10.000 = 30.200 (l)"
          },
          {
            "explanation": "Số nước ở bể thứ ba là:",
            "equation": "30.200 - 4.400 = 25.800 (l)"
          },
          {
            "explanation": "Số nước ở cả ba bể là:",
            "equation": "20.200 + 30.200 + 25.800 = 76.200 (l)"
          }
        ],
        "answer": "Đáp số: 76.200 l nước."
      }
    ]
  },
