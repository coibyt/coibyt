  "theory": {
    "title": "Bí kíp nâng cao",
    "blocks": [
      {
        "kind": "text",
        "text": "Số trung bình cộng × số các số = tổng các số. Bài rút về đơn vị: tìm giá trị một phần trước.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Nhà trường mua 20 bộ bàn ghế, mỗi bộ giá 40.000 đồng và 29 bảng tên, mỗi chiếc giá 20.000 đồng. Hỏi nhà trường phải trả tất cả bao nhiêu tiền?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Tiền mua bàn ghế là:",
            "equation": "40.000 × 20 = 800.000 (đồng)"
          },
          {
            "explanation": "Tiền mua bảng tên là:",
            "equation": "20.000 × 29 = 580.000 (đồng)"
          },
          {
            "explanation": "Nhà trường phải trả tất cả là:",
            "equation": "800.000 + 580.000 = 1.380.000 (đồng)"
          }
        ],
        "answer": "Đáp số: 1.380.000 đồng."
      }
    ]
  },
