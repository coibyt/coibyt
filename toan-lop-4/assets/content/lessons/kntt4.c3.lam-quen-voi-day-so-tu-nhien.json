  "theory": {
    "title": "Nhớ nhanh",
    "blocks": [
      {
        "kind": "text",
        "text": "Các số 0; 1; 2; 3; … là các số tự nhiên. Xếp các số tự nhiên theo thứ tự từ bé đến lớn ta được dãy số tự nhiên: 0; 1; 2; 3; 4; …",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Số 0 là số tự nhiên bé nhất. Không có số tự nhiên lớn nhất."
      },
      {
        "kind": "text",
        "text": "Hai số tự nhiên liên tiếp hơn kém nhau 1 đơn vị."
      },
      {
        "kind": "text",
        "text": "Thêm 1 vào số nào cũng được số tự nhiên liền sau, nên dãy số tự nhiên kéo dài mãi.",
        "style": "tip"
      }
    ]
  },
