    "blocks": [
      {
        "kind": "text",
        "text": "Bài toán nhiều bước: tóm tắt đề, tìm lần lượt từng số trung gian; con có thể dùng sơ đồ đoạn thẳng để thấy rõ quan hệ giữa các số.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Bể thứ nhất có 24.000 l nước. Bể thứ hai có nhiều hơn bể thứ nhất 9.000 l. Bể thứ ba có ít hơn bể thứ hai 4.500 l. Hỏi cả ba bể có bao nhiêu lít nước?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Số nước ở bể thứ hai là:",
            "equation": "24.000 + 9.000 = 33.000 (l)"
          },
          {
            "explanation": "Số nước ở bể thứ ba là:",
            "equation": "33.000 - 4.500 = 28.500 (l)"
          },
          {
            "explanation": "Số nước ở cả ba bể là:",
            "equation": "24.000 + 33.000 + 28.500 = 85.500 (l)"
          }
        ],
        "answer": "Đáp số: 85.500 l nước."
      }
    ]
  },
