    "blocks": [
      {
        "kind": "text",
        "text": "Tính chất giao hoán: a × b = b × a. Tính chất kết hợp: (a × b) × c = a × (b × c).",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: 25 × 7 × 4 = (25 × 4) × 7 = 100 × 7 = 700."
      },
      {
        "kind": "text",
        "text": "Đổi chỗ các thừa số thì tích không đổi; con nhóm các thừa số nhân với nhau được số tròn chục, tròn trăm trước nhé.",
        "style": "tip"
      }
    ]
  },
