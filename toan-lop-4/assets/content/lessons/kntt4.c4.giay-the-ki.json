  "theory": {
    "title": "Nhớ nhanh",
    "blocks": [
      {
        "kind": "text",
        "text": "Giây là đơn vị đo thời gian rất ngắn: 1 phút = 60 giây. Thế kỉ là đơn vị đo thời gian rất dài: 1 thế kỉ = 100 năm.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Từ năm 1 đến năm 100 là thế kỉ thứ nhất (thế kỉ I); từ năm 101 đến năm 200 là thế kỉ II; …; từ năm 2001 đến năm 2100 là thế kỉ XXI."
      },
      {
        "kind": "text",
        "text": "Ví dụ: 2 phút = 120 giây."
      },
      {
        "kind": "text",
        "text": "Người ta dùng chữ số La Mã để ghi tên thế kỉ.",
        "style": "tip"
      }
    ]
  },
