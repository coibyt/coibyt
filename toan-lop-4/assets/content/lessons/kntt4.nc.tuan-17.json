      {
        "kind": "text",
        "text": "Ví dụ: Hiện nay tổng số tuổi của mẹ và con là 52 tuổi, mẹ hơn con 28 tuổi. Hỏi 5 năm nữa con bao nhiêu tuổi?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Tuổi con hiện nay là:",
            "equation": "(52 - 28) : 2 = 12 (tuổi)"
          },
          {
            "explanation": "5 năm nữa tuổi con là:",
            "equation": "12 + 5 = 17 (tuổi)"
          }
        ],
        "answer": "Đáp số: 17 tuổi."
      }
    ]
