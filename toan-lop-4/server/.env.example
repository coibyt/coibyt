# Sao chép file này thành ".env" rồi sửa giá trị. KHÔNG commit file .env.
# (Windows: copy .env.example .env   |   macOS/Linux: cp .env.example .env)

# Chuỗi kết nối PostgreSQL. Giá trị dưới khớp với docker-compose.yml — CHỈ dùng trên máy cá nhân.
DATABASE_URL=postgres://toan3:toan3_dev_only@localhost:5432/toan3

# Cổng HTTP của server.
PORT=8080

# Mã quản trị cho trang CMS /admin (ít nhất 16 ký tự). Còn để nguyên placeholder => CMS bị tắt (503).
# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=<<ĐỔI-THÀNH-CHUỖI-NGẪU-NHIÊN>>

# true = chấp nhận biên nhận giả bắt đầu bằng "TEST-" (chỉ để thử). Server từ chối chạy nếu NODE_ENV=production.
IAP_DEV_MODE=false

# Xác minh mua hàng thật với Apple / Google (chưa cài đặt — xem README).
APPLE_SHARED_SECRET=<<placeholder>>
GOOGLE_SERVICE_ACCOUNT_JSON=<<placeholder>>

# Các origin trình duyệt được phép gọi API (CORS), cách nhau bởi dấu phẩy. Để trống = không cho origin nào.
# App Flutter trên điện thoại KHÔNG cần CORS.
CORS_ORIGINS=

# Số lần gọi /v1/auth/* tối đa mỗi phút cho một IP.
AUTH_RATE_LIMIT_PER_MIN=20

# Đặt "1" nếu server chạy sau reverse proxy (nginx, Caddy...) để lấy đúng IP người dùng.
TRUST_PROXY=0

# Chỉ dùng khi chạy "npm test": CSDL RIÊNG cho test (tên phải kết thúc bằng _test, sẽ bị XOÁ SẠCH mỗi lần test).
TEST_DATABASE_URL=postgres://toan3:toan3_dev_only@localhost:5432/toan3_test
