# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://varaaai.com"
NODE_ENV="development"

# ── Database (Hostinger MySQL) ──────────────────────────────────────
# hPanel > Databases > MySQL Databases. Use the "remote MySQL" host if the
# app runs on a different server than the database.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/varaaai"

# ── Auth (Auth.js / NextAuth v5) ─────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="https://varaaai.com"

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email (SMTP — used for verification, booking confirmations) ─────
# Hostinger mailbox SMTP, or any provider (SendGrid, Mailgun, etc.)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@varaaai.com"
SMTP_PASSWORD=""
SMTP_FROM="VaraaAi.Com <noreply@varaaai.com>"

# ── Salon check tool (/salon-check) — both optional ──────────────────
# Without these, the tool still works: it falls back to the visitor's own
# self-reported Google status and a template-based summary sentence.
#
# Google Places API — https://console.cloud.google.com/apis/credentials
# Enable the "Places API" on the project, enable billing (Google gives a
# recurring free monthly credit that normally covers this at small scale).
# Real rating/review-count/photo-count data for a salon's Google Business
# Profile.
GOOGLE_PLACES_API_KEY=""
# Anthropic API key — https://console.anthropic.com/settings/keys
# Used only to generate the short natural-language summary sentence.
ANTHROPIC_API_KEY=""

# ── Payments: Stripe (sandbox/test keys to start) ────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Payments: VNPay (sandbox) ────────────────────────────────────────
# https://sandbox.vnpayment.vn/apis/
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_HOST="https://sandbox.vnpayment.vn"
VNPAY_RETURN_URL="https://varaaai.com/api/payments/vnpay/return"

# ── Payments: MoMo (sandbox) ─────────────────────────────────────────
# https://developers.momo.vn/ (test credentials from their sandbox docs)
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"
MOMO_REDIRECT_URL="https://varaaai.com/api/payments/momo/return"
MOMO_IPN_URL="https://varaaai.com/api/payments/momo/ipn"

# ── Misc ──────────────────────────────────────────────────────────────
# Used to sign booking-cancellation / review-invite links
APP_SECRET="replace-with-another-long-random-string"
