// VaraaAi.Com — multi-vendor appointment booking marketplace
// Database: MySQL (Hostinger Cloud Hosting)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────
// Auth
// ────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  BUSINESS_OWNER
  STAFF
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  // Set while an email change is awaiting confirmation — `email` itself
  // stays the old, working address until the new one is verified (see
  // /api/auth/change-email and /api/auth/verify-email).
  pendingEmail  String?
  image         String?
  password      String? // null when the user only signs in via OAuth
  phone         String?
  role          UserRole  @default(CUSTOMER)
  locale        String    @default("vi")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Opted out of a salon's bulk marketing emails via the unsubscribe link.
  // Never gates transactional email (confirmations, reminders, receipts).
  marketingOptOut    Boolean @default(false)
  // Same idea for text-message marketing — captured from the booking form's
  // consent checkboxes. No SMS-sending integration exists yet; this only
  // records consent so it's ready once one is wired up.
  smsMarketingOptOut Boolean @default(false)

  // A frictionless "chat without registering" identity — created the first
  // time an anonymous visitor opens a salon's chat (see POST /api/chat/start)
  // instead of forcing sign-up first. Has a name, no password, and a
  // synthetic @guest.varaaai.com email that's never actually reachable —
  // excluded from marketing sends and customer lists for that reason.
  isGuest           Boolean @default(false)
  // A real email the guest typed in to start the chat, so the salon has a
  // way to reach them back — kept separate from `email` above (which stays
  // the synthetic placeholder) so the guest's name/password-free identity
  // never collides with an existing real account just because they typed a
  // known address. Only ever set for isGuest rows.
  guestContactEmail String?

  // "Vara points" — a salon-owner account's shared balance across every
  // branch they run, spent 1-per-email on marketing sends (see
  // /api/business/marketing/send) and earned via daily check-in and the
  // owner's own "become a salon owner" referral link. See VaraPointTransaction
  // for the full ledger; this column is always that ledger's running total.
  varaPoints          Int     @default(0)
  // "YYYY-MM-DD" (UTC) of the last daily check-in claimed — a plain string,
  // not a DateTime, so "already checked in today" is a single string compare
  // with no timezone math.
  varaLastCheckinDate String?
  // This owner's own code for the salon-owner signup program — set the
  // first time they become an owner. Shares the `?aff=` URL/cookie
  // mechanism with the admin-run PlatformAffiliate program, but rewards
  // vara points instead of a commission.
  referralCode        String? @unique

  accounts                Account[]
  sessions                Session[]
  businesses              Business[] // one or more branches when role = BUSINESS_OWNER
  staffProfile            Staff? // present when role = STAFF
  bookings                Booking[]
  reviews                 Review[]
  customerReviewsReceived CustomerReview[]
  conversations           Conversation[]
  messages                Message[]
  businessFollows         BusinessFollow[]
  postComments            PostComment[]
  varaPointTransactions   VaraPointTransaction[]
  referralClicksReceived  ReferralClick[]
  // Businesses created by someone who signed up through this owner's own
  // referral link (see Business.referredByOwner below).
  referredBusinesses      Business[]               @relation("BusinessReferredByOwner")
  emailRecipientCooldowns EmailRecipientCooldown[]

  // Announcements posted after this moment count as "unread" for a salon
  // owner — see Announcement below.
  announcementsSeenAt DateTime?
  supportThread       SupportThread?
  productReviews      ProductReview[]
  orders              Order[]
  messageReactions    MessageReaction[]
  pushSubscriptions   PushSubscription[]
  postLikes           PostLike[]
  passwordResetTokens PasswordResetToken[]
  avatar              UserAvatar?
  // Present only when this install happened while signed in — most installs
  // are anonymous (see PwaInstall below).
  pwaInstalls         PwaInstall[]
  priceListDrafts     PriceListDraft[]
  customerNotes       CustomerNote[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Kept separate from VerificationToken (which is also used for email
// verification/change, keyed by email as `identifier`) so a reset link can
// never be confused with — or consumed by — that other flow.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A customer/owner's uploaded profile photo — stored in the DB like every
// other image here (Hostinger's git-based deploy wipes public/uploads).
// User.image is kept pointed at `/api/account-avatar/<userId>` once one of
// these exists, so every existing `image` usage (NavUserMenu, chat, feed
// comments, etc.) picks it up without further changes.
model UserAvatar {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageData     Bytes    @db.LongBlob
  imageMimeType String
  updatedAt     DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────────
// Marketplace: businesses, categories, services, staff, availability
// ────────────────────────────────────────────────────────────────────

enum BusinessStatus {
  PENDING // awaiting admin approval
  APPROVED
  REJECTED
  SUSPENDED
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameVi    String
  nameEn    String
  icon      String? // lucide-react icon name
  createdAt DateTime @default(now())

  businesses BusinessCategory[]
  services   Service[]
}

model Business {
  id           String         @id @default(cuid())
  // Income report reminders for staff (Doanh thu page): null = off. Set to a
  // week before the owner turned them on; bookings that ended before it
  // aren't chased.
  incomeRemindersSince DateTime?
  // Not unique: one owner account can run several branches (Business rows) —
  // the dashboard switches between them via the `varaaai_business` cookie.
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug         String         @unique
  name         String
  description  String?        @db.Text
  logoUrl      String?
  coverUrl     String?
  status       BusinessStatus @default(PENDING)
  rejectReason String?        @db.Text

  addressLine   String?
  city          String?
  country       String  @default("VN")
  lat           Float?
  lng           Float?
  phone         String?
  email         String?
  website       String?
  facebookUrl   String?
  instagramUrl  String?
  tiktokUrl     String?
  youtubeUrl    String? // channel link, shown as an icon
  introVideoUrl String? // a single YouTube video customers can watch inline to preview the salon
  googleMapsUrl String?
  // The salon's Google "Place ID" (from Google's own Place ID Finder tool) —
  // lets a customer's "share this review to Google" button open Google's own
  // review-writing page for this exact business. Nothing can be posted to
  // Google on the salon's behalf; this only builds that one deep link.
  googlePlaceId String?
  whatsapp      String? // phone number in international format, used for a wa.me link

  timezone String @default("Asia/Ho_Chi_Minh")

  // The language/currency this salon's own customers should see by default
  // (e.g. the embed widget's default locale) — distinct from the viewing
  // customer's own site-wide language preference.
  defaultLocale   String @default("vi")
  defaultCurrency String @default("VND")

  // How many hours before the appointment a CUSTOMER can still self-cancel;
  // past that, only the business can cancel from their own dashboard.
  cancellationWindowHours Int     @default(24)
  // Free-text policy shown to the customer after booking and included in
  // their confirmation email — distinct from cancellationWindowHours, which
  // only drives the self-cancel cutoff, not what's actually printed.
  cancellationPolicy      String? @db.Text

  // Owner-controlled — turned on for when they're away, so the chat widget
  // auto-replies to customers using the salon's own active services/products
  // (see src/lib/chat-ai.ts). Off by default: an unconfigured ANTHROPIC_API_KEY
  // makes replies silently no-op anyway, but the toggle itself is explicit so
  // a salon that doesn't want a bot talking to its customers never gets one.
  aiChatEnabled Boolean @default(false)

  // Where customers send money for the "bank transfer" payment method —
  // no automatic reconciliation, same trust model as pay-at-salon cash.
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  bankBic           String?

  // Printed on every invoice issued from the "pay at the counter" checkout —
  // set once on the Settings page before the salon can issue invoices at all
  // (see POST /api/business/invoices).
  invoiceCompanyName    String?
  invoiceCompanyAddress String? @db.Text
  invoiceTaxId          String? // business ID / tax number
  invoiceVatPercent     Float?  @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  // Set once, at signup, when this salon came in through a platform
  // affiliate's referral link (see PlatformAffiliate and
  // PlatformAffiliateCookieSetter) — never changes afterward.
  referredByAffiliateId String?
  referredByAffiliate   PlatformAffiliate? @relation(fields: [referredByAffiliateId], references: [id])

  // Set once, at signup, when this salon came in through another salon
  // owner's own vara-points referral link (distinct from referredByAffiliate
  // above, which is the admin-run commission program). referralBonusAwarded
  // flips true the first time this business's profile clears the qualifying
  // bar (address + hours + an active service — see checkAndAwardReferralBonus
  // in src/lib/vara-points.ts), at which point referredByOwner is paid their
  // one-time 1000-point bonus.
  referredByOwnerId    String?
  referredByOwner      User?   @relation("BusinessReferredByOwner", fields: [referredByOwnerId], references: [id])
  referralBonusAwarded Boolean @default(false)

  categories              BusinessCategory[]
  services                Service[]
  serviceGroups           ServiceGroup[]
  landingPage             LandingPage?
  staff                   Staff[]
  bookings                Booking[]
  reviews                 Review[]
  customerReviewsGiven    CustomerReview[]
  hours                   BusinessHours[]
  closures                BusinessClosure[]
  addOns                  ServiceAddOn[]
  images                  BusinessImage[]
  conversations           Conversation[]
  followers               BusinessFollow[]
  posts                   Post[]
  emailCampaigns          EmailCampaign[]
  marketingImages         MarketingImage[]
  marketingContacts       MarketingContact[]
  customerNotes           CustomerNote[]
  chatQuickReplies        ChatQuickReply[]
  affiliates              Affiliate[]
  emailRecipientCooldowns EmailRecipientCooldown[]
  giftCards               GiftCard[]
  loyaltyCards            LoyaltyCard[]
  loyaltyProgram          LoyaltyProgram?
  products                Product[]
  productGroups           ProductGroup[]
  productReviews          ProductReview[]
  orders                  Order[]
  pageViews               BusinessPageView[]
  qrScans                 QrScan[]

  @@index([ownerId])
  @@index([status])
  @@index([city])
  @@index([referredByOwnerId])
  @@index([referredByAffiliateId])
}

// One row per public profile page load — never deduplicated, same "raw
// counter" spirit as Product.viewCount, but kept as a row-per-visit table
// (instead of a running total) so the admin "all businesses" page can
// filter total views by day/week/month/custom range.
model BusinessPageView {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// One row per confirmed PWA install (the browser's `appinstalled` event) —
// site-wide, not per-business, since installing is a one-time action on the
// whole app, not any one salon's page. customerId is set only when the
// visitor happened to be signed in at that moment; most installs are
// anonymous, so the admin count is of install EVENTS, not unique people.
model PwaInstall {
  id         String   @id @default(cuid())
  customerId String?
  customer   User?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  locale     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// One row per "ping" from SiteVisitTracker — mounted site-wide (every
// varaaai.com page under the main [locale] layout; never on /embed, which
// renders inside a salon's OWN external website, or /site/[slug], a salon's
// own branded page). visitorId is a random id a browser keeps in
// localStorage, never tied to a real identity — purely so the admin
// dashboard can count DISTINCT visitors (not raw page loads) for "today" and
// "online right now" (anyone pinged within the last few minutes), without
// needing accounts, cookies, or any PII.
model SiteVisit {
  id        String   @id @default(cuid())
  visitorId String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
}

// A one-off marketing email an owner composes and sends to everyone who has
// ever booked with them (past customers only — never a random mailing list).
// Kept as a log for the dashboard's campaign history; the recipient list
// itself isn't stored, since it's re-derived fresh from bookings each send
// so a customer who unsubscribes or a new booking never goes stale.
model EmailCampaign {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subject        String
  bodyHtml       String   @db.Text
  recipientCount Int
  createdAt      DateTime @default(now())

  // The campaign as the owner wrote it, so it can be previewed, reused and
  // (when scheduled) rendered per recipient at send time. Older campaigns
  // only have subject + bodyHtml.
  preheader       String?   @db.VarChar(200)
  headline        String?   @db.VarChar(160)
  message         String?   @db.Text
  imageId         String?
  // NONE | BOOK (the salon's booking page) | URL (ctaUrl)
  ctaKind         String    @default("BOOK") @db.VarChar(8)
  ctaLabel        String?   @db.VarChar(60)
  ctaUrl          String?   @db.VarChar(500)
  offerTitle      String?   @db.VarChar(80)
  offerCode       String?   @db.VarChar(40)
  offerExpires    DateTime?
  // Who it goes to — see src/lib/marketing-recipients.ts
  segment         String    @default("ALL") @db.VarChar(16)
  includeCooldown Boolean   @default(false)
  // Gives every recipient a loyalty card: a new one when they have none,
  // otherwise their existing code — shown in the email with the QR and how
  // to use it (src/lib/marketing-send.ts).
  loyaltyCard     Boolean   @default(false)
  // SCHEDULED → SENDING → SENT, or CANCELLED. Campaigns sent before this
  // existed are SENT.
  status          String    @default("SENT") @db.VarChar(12)
  scheduledAt     DateTime?
  sentAt          DateTime?
  // Unique recipients who opened / clicked (EmailCampaignEvent).
  openCount       Int       @default(0)
  clickCount      Int       @default(0)

  events EmailCampaignEvent[]

  @@index([businessId, createdAt])
  @@index([status, scheduledAt])
}

// One open or click per recipient per campaign, for the campaign's stats.
model EmailCampaignEvent {
  id         String        @id @default(cuid())
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  // OPEN | CLICK
  kind       String        @db.VarChar(8)
  createdAt  DateTime      @default(now())

  @@unique([campaignId, customerId, kind])
}

// A customer the salon added to its email list by hand or from an Excel/CSV
// file, on top of the customers who booked on VaraaAi. One per email per
// salon; the salon confirms each import has the customers' consent.
model MarketingContact {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email         String    @db.VarChar(191)
  name          String?   @db.VarChar(120)
  phone         String?   @db.VarChar(40)
  note          String?   @db.VarChar(500)
  // Clicked "unsubscribe" in one of this salon's emails.
  optedOut      Boolean   @default(false)
  // The 72h anti-spam cooldown, like EmailRecipientCooldown for users.
  lastEmailedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([businessId, email])
}

// A saved reply the salon can drop into a chat with one tap.
model ChatQuickReply {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String   @db.VarChar(60)
  text       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// The salon's private note about one of its customers (allergies,
// preferences, favourite colours…). Never shown to the customer.
model CustomerNote {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, customerId])
  @@index([customerId])
}

// A picture added to a marketing email. Bytes live on the row, same reasoning
// as BusinessImage (Hostinger wipes public/uploads on deploy).
model MarketingImage {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  data       Bytes    @db.MediumBlob
  mimeType   String   @db.VarChar(40)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

model BusinessCategory {
  businessId String
  categoryId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
}

// Regular weekly opening hours, e.g. Monday 09:00–18:00
model BusinessHours {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekday     Int // 0 = Sunday … 6 = Saturday
  openMinute  Int // minutes since midnight, e.g. 540 = 09:00
  closeMinute Int // e.g. 1080 = 18:00

  @@index([businessId])
}

// One-off closures / holidays that override BusinessHours for a specific date
model BusinessClosure {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  reason     String?

  @@unique([businessId, date])
}

model Staff {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  title      String?
  bio        String?  @db.Text
  avatarUrl  String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Optional login for this staff member — null means they're just a
  // schedulable name with no dashboard access of their own. Permissions
  // below only gate the "view-only" dashboard sections; Staff management
  // and Settings always stay owner-only regardless of these flags.
  userId                     String? @unique
  user                       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  canViewServices            Boolean @default(false)
  canViewProducts            Boolean @default(false)
  canViewBookings            Boolean @default(true)
  canViewCustomers           Boolean @default(false)
  canViewHours               Boolean @default(false)
  canViewReviews             Boolean @default(false)
  // Separate from canViewBookings — a staff member can see the bookings
  // calendar without seeing customers' phone/email on each booking unless
  // this is also granted.
  canViewCustomerContactInfo Boolean @default(false)
  // When false (and canViewBookings is true), this staff member only sees and
  // acts on bookings assigned to them — never another staff member's. Defaults
  // to true so existing staff keep seeing the whole salon's calendar.
  canViewAllBookings         Boolean @default(true)
  // Grants read-only access to every other dashboard section too — Fanpage,
  // Trang landing, Marketing, Thẻ quà tặng, Thẻ tích điểm, Hỗ trợ — none of
  // which this staff model otherwise exposes at all. Still never Staff
  // management or Settings (see the note above), and "read-only" here is
  // enforced the same way every other staff view already is: each section's
  // own write endpoints stay owner-only, so granting this never hands out
  // any new ability to create/edit/delete anything — only to see the page.
  canViewAllPagesReadOnly    Boolean @default(false)
  // Last time this person was reminded (email + push) about bookings they
  // haven't reported income for — at most once a day.
  incomeReminderSentAt       DateTime?
  // The same person working at several of the owner's branches: one Staff
  // row per branch (own services and hours there), all sharing this id. Only
  // one of them carries the login (userId). Their bookings at any branch
  // block the same time at the others — see src/lib/staff-branches.ts.
  branchGroup                String?   @db.VarChar(32)
  // Minutes this person needs to get from one branch to another: a booking
  // at another branch blocks this much extra time before and after it here.
  // Kept the same on every row of the group.
  branchTravelMinutes        Int       @default(0)

  // Minutes of advance notice a customer must give to book this staff member
  // (0, 15, 30, 60, 120, 180, 360, 720) — gives them time to prepare, on top
  // of the platform's own minimum lead time.
  leadTimeMinutes Int     @default(0)
  // Shown to the customer when they pick this staff member while booking,
  // and included in their confirmation email.
  staffMessage    String? @db.Text
  // Up to 5 YouTube links to past work, shown as "watch" buttons next to
  // this staff member on the booking page.
  videoUrls       Json?

  services             StaffService[]
  bookings             Booking[]
  timeOff              StaffTimeOff[]
  hours                StaffHours[]
  avatar               StaffAvatar?
  bookingExtraServices BookingExtraService[]

  @@index([businessId])
  @@index([branchGroup])
}

// Kept off the Staff row itself, same reasoning as BusinessImage/LandingImage
// — ordinary staff queries (the dashboard list, booking dropdowns) never pull
// a multi-MB blob along for the ride.
model StaffAvatar {
  id        String   @id @default(cuid())
  staffId   String   @unique
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt
}

// Per-staff weekly schedule. A staff member with zero rows here just follows
// the business's own hours (BusinessHours) — this is opt-in customization,
// not a required setup step for every staff member.
model StaffHours {
  id          String  @id @default(cuid())
  staffId     String
  staff       Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday     Int // 0 = Sunday … 6 = Saturday
  openMinute  Int
  closeMinute Int
  // Date range this weekly schedule applies to, as YYYY-MM-DD in the salon's
  // timezone. Both null = always. A day outside every range falls back to the
  // salon's own opening hours (see staffWindowsForDate in src/lib/staff-hours.ts).
  validFrom   String?
  validUntil  String?

  @@index([staffId])
}

// Staff-specific time off (vacation, sick day) blocking bookings
// A block of a staff member's own time (lunch, sick leave, an errand…) —
// customers can't book into it. Created from the bookings calendar by
// picking a "personal time" entry instead of a service; never shown to
// customers.
model StaffTimeOff {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  // One of the kinds in src/lib/personal-time.ts (LUNCH, SICK, …); null for
  // older rows.
  kind      String?  @db.VarChar(24)
  // A free-text note for the salon.
  reason    String?
  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([staffId, startsAt])
}

// A salon's own section headings for its service menu ("Nails", "Lash
// extensions"...), shown as grouped sections on the public page and the
// services dashboard — distinct from the platform-wide Category, which
// only drives search.
model ServiceGroup {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  services Service[]

  @@index([businessId])
}

model Service {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Position within its group/section, set by dragging in the dashboard;
  // customers see services in this order.
  sortOrder    Int           @default(0)
  groupId      String?
  group        ServiceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id])
  name         String
  description  String?       @db.Text
  durationMin  Int // e.g. 60
  bufferMin    Int           @default(0) // cleanup/prep time added after the appointment
  priceCents   Int // stored in the smallest currency unit
  currency     String        @default("VND")
  depositCents Int? // optional required deposit to confirm a booking
  videoUrl     String? // YouTube preview clip shown next to the service
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  staff        StaffService[]
  bookings     Booking[]
  addOns       ServiceAddOnLink[]
  bookingExtra BookingExtraService[]
  giftCards    GiftCard[]

  @@index([businessId])
  @@index([categoryId])
  @@index([groupId])
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // Null means "use the service's own price/duration" — set only when this
  // staff member charges or takes a different amount of time for it.
  priceCentsOverride  Int?
  durationMinOverride Int?

  @@id([staffId, serviceId])
}

// Optional extras a customer can add on top of a main service (e.g. a
// "gloss treatment" add-on next to a haircut) — a business-wide catalog,
// each item opted into per service via ServiceAddOnLink.
model ServiceAddOn {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  priceCents  Int
  durationMin Int      @default(0) // extra minutes tacked onto the appointment
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  services      ServiceAddOnLink[]
  bookingAddOns BookingAddOn[]

  @@index([businessId])
}

model ServiceAddOnLink {
  serviceId String
  addOnId   String
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  addOn     ServiceAddOn @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([serviceId, addOnId])
}

enum ImageKind {
  LOGO
  COVER
}

// Logo/cover bytes live in the DB, not on disk — Hostinger's git-based
// deploy recreates the app directory from scratch on every push, which
// silently wiped anything written to public/uploads at runtime. Kept off
// the Business row itself (a separate model) so ordinary Business queries
// never pull multi-MB blobs along for the ride.
model BusinessImage {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       ImageKind
  data       Bytes
  mimeType   String
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, kind])
}

// ────────────────────────────────────────────────────────────────────
// Bookings, payments, reviews
// ────────────────────────────────────────────────────────────────────

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Booking {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  staffId    String?
  staff      Staff?   @relation(fields: [staffId], references: [id])
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])

  startsAt DateTime
  endsAt   DateTime
  status   BookingStatus @default(PENDING_PAYMENT)
  source   BookingSource @default(WEBSITE)

  priceCents   Int
  depositCents Int?
  currency     String @default("VND")

  customerNote String? @db.Text
  cancelReason String? @db.Text

  // Always true for a customer's own booking (confirmation/reminder emails
  // are the whole point). For a booking the salon adds manually from the
  // calendar, the owner opts in via a checkbox — off by default, since a
  // manually-added walk-in/phone booking usually doesn't need automated
  // email traffic. Gates every email tied to this booking: confirmation,
  // reschedule, cancellation, and the reminder/review cron.
  notificationEmailsEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set the moment each automated email actually goes out — the cron job at
  // /api/cron/reminders reads these as an idempotency guard (never send the
  // same reminder twice) rather than relying on a narrow time window, so it
  // stays correct no matter how often that job actually runs. Cleared back
  // to null on reschedule so a moved booking gets fresh reminders for its
  // new time — see /api/business/bookings/[id]/reschedule.
  reminder24hSentAt   DateTime?
  reminder2hSentAt    DateTime?
  reminder15minSentAt DateTime?
  reviewRequestSentAt DateTime?

  // Set when this booking came in through an affiliate's referral link (see
  // Affiliate below). commissionCents is a snapshot of the affiliate's
  // commissionPercent at booking time, in this booking's own currency — so a
  // later change to the affiliate's rate never rewrites the payout owed on
  // past bookings.
  affiliateId              String?
  affiliate                Affiliate? @relation(fields: [affiliateId], references: [id])
  affiliateCommissionCents Int?

  // Set on EVERY booking this business ever takes, once its
  // referredByAffiliate signup has met the qualifying bar (see
  // isBusinessReferralQualified) — an ongoing cut of this business's
  // bookings for whoever referred the owner to VaraaAi itself, distinct
  // from `affiliate` above (which credits whoever referred this one
  // customer). Snapshotted the same way: a later rate change never
  // rewrites commission already owed on past bookings.
  platformAffiliateId              String?
  platformAffiliate                PlatformAffiliate? @relation(fields: [platformAffiliateId], references: [id])
  platformAffiliateCommissionCents Int?

  payment        Payment?
  review         Review?
  customerReview CustomerReview?
  addOns         BookingAddOn[]
  extraServices  BookingExtraService[]

  @@index([businessId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId])
  @@index([status])
  @@index([affiliateId])
  @@index([platformAffiliateId])
}

// A referral partner (an outside promoter, or a salon's own staff member)
// who earns a set commission percentage on bookings placed through their own
// tracking link/code — see the ?aff= query param on the public business page
// and AffiliateCookieSetter. Tracking-only: VaraaAi never moves the actual
// commission payout, the salon owner pays it separately and uses this only
// as a running tally of what they owe each partner.
model Affiliate {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  code              String   @unique
  commissionPercent Float
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  // How to reach the partner, for the owner's own reference.
  email             String?  @db.VarChar(191)
  phone             String?  @db.VarChar(40)
  note              String?  @db.VarChar(500)
  // Visits to the salon page through this partner's link (one per browser per day).
  clickCount        Int      @default(0)

  bookings Booking[]
  payouts  AffiliatePayout[]

  @@index([businessId])
}

// Commission the salon has paid a partner outside VaraaAi, recorded so the
// dashboard can show what's still owed. VaraaAi never moves the money.
model AffiliatePayout {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amountCents Int
  note        String?   @db.VarChar(200)
  createdAt   DateTime  @default(now())

  @@index([affiliateId])
}

// A platform-level referral partner (a sale/agent, an existing salon owner,
// or a customer) who earns an ongoing commission percentage on every booking
// a salon they referred to VaraaAi ever takes — set up by an admin, not a
// salon owner, and tracked against the `?aff=` link on the public /business
// landing page (see PlatformAffiliateCookieSetter). Tracking-only, same as
// Affiliate: VaraaAi never moves the payout itself.
model PlatformAffiliate {
  id                String   @id @default(cuid())
  name              String
  code              String   @unique
  commissionPercent Float
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  referredBusinesses Business[]
  bookings           Booking[]
}

enum VaraPointReason {
  SIGNUP_BONUS
  DAILY_CHECKIN
  REFERRAL_CLICK
  REFERRAL_SIGNUP_BONUS
  EMAIL_SENT
  EMAIL_SENT_COOLDOWN_BYPASS
}

// Full ledger behind User.varaPoints — every earn and spend is one row here,
// so the running balance on User is always reconstructable/auditable. amount
// is positive for an earn, negative for a spend (currently only EMAIL_SENT).
model VaraPointTransaction {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    VaraPointReason
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
}

// One row per unique visitor (by hashed IP) who has ever landed on an
// owner's own referral link — caps that link's "1 point per visitor" reward
// at once per IP, forever, regardless of how many times they revisit. The IP
// itself is never stored, only an HMAC of it (see hashIp in vara-points.ts).
model ReferralClick {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ipHash    String
  createdAt DateTime @default(now())

  @@unique([ownerId, ipHash])
  @@index([ownerId])
}

// The last time a marketing email actually went out to a given customer
// from a given business — the 72-hour anti-spam cooldown in
// /api/business/marketing/send reads this to decide whether a recipient is
// still "fresh" (1 point) or needs the cooldown bypassed (5 points, see
// EMAIL_SENT_COOLDOWN_BYPASS). One row per (business, customer) pair, always
// overwritten with the latest send — no history needed beyond "most recent".
model EmailRecipientCooldown {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lastSentAt DateTime

  @@unique([businessId, customerId])
  @@index([customerId])
}

enum PaymentProvider {
  STRIPE
  VNPAY
  MOMO
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id          String          @id @default(cuid())
  bookingId   String          @unique
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider    PaymentProvider
  status      PaymentStatus   @default(PENDING)
  amountCents Int
  currency    String          @default("VND")
  providerRef String? // Stripe session/intent id, VNPay TxnRef, MoMo orderId
  rawResponse String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([provider, providerRef])
}

// PENDING: just submitted, visible only to the owner, not on the public
// profile yet. APPROVED: owner published it — shown publicly. HIDDEN: owner
// chose not to publish it — kept for the owner's own reference, never
// public. Existing reviews (written before this field existed) are
// backfilled to APPROVED by the migration so nothing already live
// disappears.
enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

model Review {
  id                  String       @id @default(cuid())
  bookingId           String       @unique
  booking             Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  businessId          String
  business            Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId          String
  customer            User         @relation(fields: [customerId], references: [id])
  rating              Int // 1–5
  comment             String?      @db.Text
  ownerReply          String?      @db.Text
  status              ReviewStatus @default(PENDING)
  // When the customer was asked (email + chat) to also post on Google — sent
  // once, the first time the salon publishes or hides the review, whichever
  // it picks, so the request never depends on what the review says.
  googleRequestSentAt DateTime?
  createdAt           DateTime     @default(now())

  @@index([businessId])
  @@index([businessId, status])
}

// A salon rating its own customer after their booking's time has passed —
// the reverse of Review. Private to the business (an internal reference,
// e.g. for spotting a repeatedly difficult customer) — never shown on any
// public page. The customer only learns the star rating via email
// (ownerReviewedYouEmail), never the note.
model CustomerReview {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  rating     Int // 1–5
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([customerId])
}

// Add-ons selected for a specific booking. Name/price/duration are snapshot
// at booking time so a later price change to the catalog item never rewrites
// history — addOnId is nullable so deleting a catalog item doesn't touch it.
model BookingAddOn {
  id          String        @id @default(cuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId     String?
  addOn       ServiceAddOn? @relation(fields: [addOnId], references: [id], onDelete: SetNull)
  name        String
  priceCents  Int
  durationMin Int

  @@index([bookingId])
}

// A second (third, fourth...) full service booked in the same visit — e.g.
// a manicure booked alongside a pedicure — as opposed to a BookingAddOn,
// which is a small catalog extra tied to one specific service. Snapshot for
// the same reason as BookingAddOn: history shouldn't move if the service's
// price changes later, and serviceId is nullable so deleting the service
// doesn't touch past bookings.
model BookingExtraService {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name        String
  priceCents  Int
  durationMin Int
  // Null until the salon moves this service on the calendar — until then it
  // runs back-to-back after the primary service under the booking's staff
  // (see serviceSlots in src/lib/booking-slots.ts). Once set, it has its own
  // time and staff, which is what availability and conflict checks read.
  staffId     String?
  staff       Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  startsAt    DateTime?
  endsAt      DateTime?

  @@index([bookingId])
  @@index([staffId, startsAt])
}

// Where a booking came from: a customer on the public booking page, or the
// salon adding it from its own dashboard. Only drives calendar colouring.
enum BookingSource {
  WEBSITE
  MANUAL
}

// ────────────────────────────────────────────────────────────────────
// Chat & following
// ────────────────────────────────────────────────────────────────────

// One thread per (business, customer) pair — messages flow both ways
// through it, whether typed by the customer or by the owner/staff replying
// from the dashboard.
model Conversation {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Set the moment a customer taps "talk to the real owner" — the AI stops
  // auto-replying in THIS thread from then on, even while the business's own
  // aiChatEnabled stays on for its other conversations (see
  // POST /api/chat/conversations/[id]/request-human).
  aiPaused   Boolean  @default(false)

  messages Message[]

  @@unique([businessId, customerId])
  @@index([customerId])
}

enum MessageSenderType {
  CUSTOMER
  BUSINESS
  // An automated reply from the salon's AI assistant (see
  // Business.aiChatEnabled) — sent by a shared synthetic User row
  // (ai-assistant@system.varaaai.com), same "real row, fake identity" trick
  // as a guest customer's User row.
  AI
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     MessageSenderType
  senderId       String
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String?           @db.Text
  // Image bytes live on the row itself, same reasoning as BusinessImage —
  // Hostinger's git-based deploy wipes anything written to public/uploads.
  imageData      Bytes?            @db.LongBlob
  imageMimeType  String?
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  reactions MessageReaction[]

  @@index([conversationId, createdAt])
}

// One reaction per (message, user) — picking a new emoji replaces the old
// one, picking the same emoji again is how the client implements "un-react"
// (handled by the toggle logic in the reactions API route, not here). The
// quick "like" button in the UI is just this same table with emoji = "👍".
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

// One browser/device's Web Push subscription for a business owner (or staff
// with chat access) — lets the server push a real OS-level notification
// (e.g. "a customer wants to talk to you") without that person having the
// dashboard open. A person can have several (phone + laptop); each endpoint
// is its own row, dropped once that browser/device unsubscribes or the push
// service reports it gone (see src/lib/push.ts).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([userId])
}

// A customer following a business, for their own reference (e.g. a future
// "salons you follow" list) — distinct from having booked there before.
model BusinessFollow {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([businessId, customerId])
  @@index([customerId])
}

// ────────────────────────────────────────────────────────────────────
// Fanpage — a business's own feed of posts, shown to customers who follow
// them (see BusinessFollow above).
// ────────────────────────────────────────────────────────────────────

model Post {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  content    String?  @db.Text
  // A single YouTube link, same pattern as Business.introVideoUrl and the
  // staff portfolio videos — no self-hosted video, ever.
  videoUrl   String?
  // Kept at the top of the salon's fanpage.
  pinned     Boolean  @default(false)
  // One of PROMO, NEW_WORK, NEWS, TIP (see src/lib/fanpage-strings.ts) —
  // a label customers can filter the fanpage by. Null = no label.
  tag        String?  @db.VarChar(20)
  // A button under the post: BOOK, SHOP or CALL. Null = none.
  ctaType    String?  @db.VarChar(16)
  // When customers start seeing the post — later than createdAt for a
  // scheduled post. Feeds sort by it.
  publishAt  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  images   PostImage[]
  comments PostComment[]
  likes    PostLike[]

  @@index([businessId, createdAt])
  @@index([businessId, publishAt])
}

model PostImage {
  id            String @id @default(cuid())
  postId        String
  post          Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Bytes live on the row itself, same reasoning as BusinessImage/Message —
  // Hostinger's git-based deploy wipes anything written to public/uploads.
  imageData     Bytes  @db.LongBlob
  imageMimeType String

  @@index([postId])
}

// A customer liking a post — one per (post, user), toggled on/off.
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  // Written by the salon's owner on their own post — shown as the salon
  // (its name and logo) rather than the owner's personal account.
  asBusiness Boolean  @default(false)
  createdAt  DateTime @default(now())

  images PostCommentImage[]

  @@index([postId, createdAt])
}

model PostCommentImage {
  id            String      @id @default(cuid())
  commentId     String
  comment       PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  // Bytes live on the row itself, same reasoning as PostImage/Message.
  imageData     Bytes       @db.LongBlob
  imageMimeType String

  @@index([commentId])
}

// ────────────────────────────────────────────────────────────────────
// Support hub for salon owners — training links, announcements from the
// admin, and a direct chat with the admin team.
// ────────────────────────────────────────────────────────────────────

// A how-to video/page the admin publishes for every salon owner.
model TrainingResource {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  url         String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// A notice the admin broadcasts to every salon owner.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// One support conversation per salon-owner account (not per branch).
model SupportThread {
  id         String   @id @default(cuid())
  // The signed-in user writing in — a salon owner or a customer. Null for a
  // visitor without an account (guestName/guestEmail/guestToken instead).
  ownerId    String?  @unique
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  guestName  String?
  guestEmail String?
  // Kept in the visitor's cookie; identifies their thread without an account.
  guestToken String?  @unique
  // Language the visitor uses the site in — for AI replies and emails.
  locale     String   @default("vi")
  // Set when the visitor asks for a person or an admin replies by hand; the
  // AI assistant stays quiet in this thread until an admin turns it back on.
  aiPaused   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(cuid())
  threadId  String
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromAdmin Boolean
  // An admin-side message written by the AI support assistant.
  fromAi    Boolean       @default(false)
  content   String        @db.Text
  // Set once the other side has opened the thread and seen this message.
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
}

// ────────────────────────────────────────────────────────────────────
// Landing page — a salon's own publishable marketing page (separate from
// the always-on /b/[slug] booking profile), editable section by section
// like Timma's "Website" builder.
// ────────────────────────────────────────────────────────────────────

model LandingPage {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Hidden from the public until the owner explicitly publishes it.
  published  Boolean  @default(false)

  // Colour palette of the whole public site — a key of SITE_THEMES in
  // src/lib/site-theme.ts ("ROSE" | "CHAMPAGNE" | "NOIR" | "EMERALD" | "LAVENDER").
  theme String @default("ROSE")

  // Hero — the top section. Layout: "FULL" (photos behind the text) |
  // "IMAGE_RIGHT" | "IMAGE_LEFT" | "TEXT_ONLY".
  heroLayout       String  @default("IMAGE_RIGHT")
  // Small line above the hero title, e.g. "Nail & Lash Studio · Helsinki".
  heroEyebrow      String?
  heroTitle        String?
  heroText         String? @db.Text
  heroButtonLabel  String?
  // "BOOKING" links to the salon's own booking page; "URL" uses heroButtonUrl.
  heroButtonTarget String  @default("BOOKING")
  heroButtonUrl    String?

  // Intro/about — optional second section, same shape as the hero.
  introEnabled      Boolean @default(true)
  introLayout       String  @default("IMAGE_LEFT")
  introTitle        String?
  introText         String? @db.Text
  introButtonLabel  String?
  introButtonTarget String  @default("BOOKING")
  introButtonUrl    String?

  // Highlights — a row of feature cards (see LandingHighlight).
  highlightsEnabled Boolean @default(true)
  highlightsTitle   String?

  // Home-page sections filled automatically from the salon's own data.
  servicesEnabled Boolean @default(true) // first services in the owner's drag order
  servicesTitle   String?
  teamEnabled     Boolean @default(true)
  reviewsEnabled  Boolean @default(true)
  // Photo gallery — images in slots "gallery-0" … "gallery-7".
  galleryEnabled  Boolean @default(true)
  galleryTitle    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     LandingImage[]
  highlights LandingHighlight[]
}

model LandingHighlight {
  id            String      @id @default(cuid())
  landingPageId String
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)
  title         String
  description   String?     @db.Text
  buttonLabel   String?
  buttonTarget  String      @default("BOOKING") // "BOOKING" | "URL"
  buttonUrl     String?

  @@index([landingPageId])
}

// Landing-page images live on the row itself, same reasoning as
// BusinessImage — Hostinger's git-based deploy wipes public/uploads.
// Keyed by a free-form slot ("hero", "intro", or a highlight's own id) so
// an arbitrary number of highlight images don't need their own enum.
model LandingImage {
  id            String      @id @default(cuid())
  landingPageId String
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  slot          String
  data          Bytes
  mimeType      String
  updatedAt     DateTime    @updatedAt

  @@unique([landingPageId, slot])
}

// A gift card template a salon creates for one of its services: a percentage
// discount, valid for a number of days after activation and usable a set
// number of times. Sold through the salon's booking page (see GiftCardPurchase).
model GiftCard {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name            String
  discountPercent Int
  validDays       Int
  maxUses         Int
  salePriceCents  Int
  currency        String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  purchases GiftCardPurchase[]

  @@index([businessId])
  @@index([serviceId])
}

enum GiftCardStatus {
  PENDING_PAYMENT
  ACTIVE
  CANCELLED
}

// One card sold to a customer. Activated when the salon confirms payment; the
// code and QR token are what the customer presents at the salon.
model GiftCardPurchase {
  id          String         @id @default(cuid())
  giftCardId  String
  giftCard    GiftCard       @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  businessId  String
  buyerName   String
  buyerEmail  String
  buyerPhone  String?
  // Optional personal note printed on the gift card image (cards the salon
  // issues and emails from the dashboard).
  message     String?        @db.Text
  code        String         @unique
  status      GiftCardStatus @default(PENDING_PAYMENT)
  activatedAt DateTime?
  expiresAt   DateTime?
  usesLeft    Int
  createdAt   DateTime       @default(now())

  redemptions GiftCardRedemption[]

  @@index([businessId, status])
}

model GiftCardRedemption {
  id         String           @id @default(cuid())
  purchaseId String
  purchase   GiftCardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  bookingId  String?
  createdAt  DateTime         @default(now())

  @@index([purchaseId])
}

// The salon's loyalty rule: every N visits earns a discount. One per salon.
model LoyaltyProgram {
  id              String   @id @default(cuid())
  businessId      String   @unique
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pointsRequired  Int
  discountPercent Int
  priceCents      Int
  currency        String
  updatedAt       DateTime @updatedAt
}

// A customer's loyalty card at one salon. Activated by the salon (which sends
// the QR by email). Points are scans, but a scan only counts while there are
// more completed visits than scans — see src/lib/loyalty.ts.
model LoyaltyCard {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String
  customerPhone String?
  token         String   @unique
  points        Int      @default(0)
  totalScans    Int      @default(0)
  rewardReady   Boolean  @default(false)
  rewardsEarned Int      @default(0)
  activatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  // The code in this customer's "invite a friend" link (/invite/<code>) —
  // separate from `token`, which is the card's own QR. Made on first use.
  referralCode  String?  @unique @db.VarChar(16)

  scans     LoyaltyScan[]
  rewards   LoyaltyReward[]
  referrals LoyaltyReferral[]

  @@unique([businessId, customerEmail])
}

// A friend who booked this salon through a customer's invite link. When the
// friend's first visit has happened, the inviter's card gets bonus tickets
// (src/lib/loyalty-referral.ts). One per friend per salon.
model LoyaltyReferral {
  id             String      @id @default(cuid())
  cardId         String
  card           LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  businessId     String
  friendUserId   String
  friendName     String
  // The friend's first booking at the salon, which decides the bonus.
  bookingId      String?     @unique
  // PENDING until that visit has happened, then REWARDED.
  status         String      @default("PENDING") @db.VarChar(16)
  ticketsAwarded Int         @default(0)
  createdAt      DateTime    @default(now())
  rewardedAt     DateTime?

  @@unique([businessId, friendUserId])
  @@index([cardId])
}

model LoyaltyScan {
  id        String      @id @default(cuid())
  cardId    String
  card      LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([cardId])
}

// Each time the salon applies a loyalty reward, so the customer's history can
// show it on the day it happened.
model LoyaltyReward {
  id        String      @id @default(cuid())
  cardId    String
  card      LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([cardId])
}

// A receipt issued from the dashboard's "pay at the counter" checkout — see
// src/lib/invoices.ts. businessId/bookingId/customerId are plain ids (not
// Prisma relations), same convention as GiftCardPurchase, since nothing else
// needs to join through this table. The company/VAT fields are a snapshot of
// the business's Settings at the moment of issue, so a later edit there never
// changes an invoice already handed to a customer.
model Invoice {
  id         String  @id @default(cuid())
  businessId String
  bookingId  String?
  customerId String

  number String // display number, e.g. INV-20261007-AB12
  token  String @unique // the public /invoice/[token] link encoded in the QR

  lines         Json // [{ name, qty, unitPriceCents, totalCents }]
  subtotalCents Int
  vatPercent    Float
  vatCents      Int
  totalCents    Int
  currency      String

  paymentMethod InvoicePaymentMethod
  giftCardCode  String?
  note          String?              @db.Text

  companyName    String?
  companyAddress String? @db.Text
  companyTaxId   String?

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([bookingId])
  @@index([customerId])
}

enum InvoicePaymentMethod {
  CASH
  BANK_TRANSFER
  GIFT_CARD
}

// ────────────────────────────────────────────────────────────────────
// Products — physical/retail items a salon sells alongside its services
// (nail files, gel polish, hand oil, gift cards...), with their own photo
// gallery, customer reviews, and a simple cart/checkout.
// ────────────────────────────────────────────────────────────────────

// A salon's own section headings for its product catalog — same pattern as
// ServiceGroup for services.
model ProductGroup {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  products Product[]

  @@index([businessId])
}

model Product {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  groupId        String?
  group          ProductGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name           String
  // Maker shown above the name in the shop, e.g. "OPI" or "Olaplex".
  brand          String?       @db.VarChar(80)
  description    String?       @db.Text
  priceCents     Int
  // The regular price when the product is on sale — the shop shows it struck
  // through next to priceCents, with the discount. Null = not on sale.
  compareAtCents Int?
  currency       String        @default("VND")
  videoUrl       String? // YouTube preview clip, same convention as Service.videoUrl
  // Position in the shop, set by dragging in the dashboard.
  sortOrder      Int           @default(0)
  // Pinned to the "Featured" row at the top of the shop.
  featured       Boolean       @default(false)
  // Still shown, but can't be added to the cart or ordered.
  soldOut        Boolean       @default(false)
  // Kept in the dashboard but not shown to customers (unlike active=false,
  // which is a delete).
  hidden         Boolean       @default(false)
  // Shown on the product page as its view count — incremented once per page
  // load (see GET /api/products/[id]), not a precise unique-visitor count.
  viewCount      Int           @default(0)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  images     ProductImage[]
  reviews    ProductReview[]
  orderItems OrderItem[]

  @@index([businessId])
  @@index([groupId])
}

model ProductImage {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Bytes live on the row itself, same reasoning as BusinessImage/PostImage —
  // Hostinger's git-based deploy wipes anything written to public/uploads.
  imageData     Bytes   @db.LongBlob
  imageMimeType String
  sortOrder     Int     @default(0)

  @@index([productId])
}

// A customer's review of a product — independent of Review (which is tied to
// a completed Booking), since a product purchase isn't calendar-shaped. One
// review per customer per product, same one-review discipline as Review.
model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  rating     Int // 1–5
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  images ProductReviewImage[]

  @@unique([productId, customerId])
  @@index([businessId])
  @@index([productId])
}

model ProductReviewImage {
  id            String        @id @default(cuid())
  reviewId      String
  review        ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  imageData     Bytes         @db.LongBlob
  imageMimeType String

  @@index([reviewId])
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

// How the customer intends to pay — same trust model as a booking's
// cash/bank-transfer choice: no payment gateway, the salon reconciles
// manually. CHAT means the customer wants to discuss another arrangement
// with the salon instead of picking one up front — the order still gets
// created (so the salon sees what was requested) and the business's chat
// opens for them to work it out.
enum OrderPaymentMethod {
  CASH
  BANK_TRANSFER
  CHAT
}

model Order {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])

  status        OrderStatus        @default(PENDING_PAYMENT)
  paymentMethod OrderPaymentMethod
  totalCents    Int
  currency      String             @default("VND")
  customerNote  String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([businessId, createdAt])
  @@index([customerId])
}

// Snapshots the product's name/price at order time, so a later edit to the
// product (or even deleting it) never rewrites a past order's receipt.
model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String
  unitPriceCents Int
  currency       String
  qty            Int
  totalCents     Int

  @@index([orderId])
  @@index([productId])
}

// A price list made with the free /tools/price-list tool, saved to the
// maker's account so they can come back and edit it. `data` is the editor's
// own document (salon info, categories, services, design choices); the logo
// lives in its own column, same reasoning as BusinessImage — Hostinger's
// git-based deploy wipes anything written to disk.
model PriceListDraft {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  data      Json
  logoData  Bytes?   @db.MediumBlob
  logoMime  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// One visit to a salon's booking page that came from a printed QR code
// (?utm_source=price_list / qr_poster) — counted for the owner's dashboard.
model QrScan {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source     String
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// Anonymous usage counters for the free marketing tools (opened, downloaded
// a PDF/PNG, clicked the sign-up call to action) — readable in the admin
// page without needing Google Analytics set up.
model ToolEvent {
  id        String   @id @default(cuid())
  tool      String
  event     String
  createdAt DateTime @default(now())

  @@index([tool, event, createdAt])
}

// Platform-wide switches the admin changes from the admin pages, as
// key/value pairs (e.g. "supportAi" = "on").
model PlatformSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// What a staff member collected for one booking — cash, bank and up to two
// gift cards — reported from the booking on the calendar, then checked and
// approved by the owner (Doanh thu page). businessId/bookingId/staffId are
// plain ids like Invoice; the customer, service, date and amount due are a
// snapshot so the owner can compare even if the booking changes later.
model StaffIncomeReport {
  id             String    @id @default(cuid())
  businessId     String
  // A booking — or, for personal time that can earn money (Tuyển người mẫu,
  // see INCOME_KINDS in src/lib/personal-time.ts), that StaffTimeOff row.
  bookingId      String?   @unique
  timeOffId      String?   @unique
  // The booking's staff member (null when the booking had none).
  staffId        String?
  staffName      String?   @db.VarChar(120)
  customerName   String    @db.VarChar(160)
  serviceName    String    @db.VarChar(200)
  serviceAt      DateTime
  // The booking's total to collect, for comparing with what was reported.
  expectedCents  Int
  currency       String    @db.VarChar(3)
  cashCents      Int       @default(0)
  bankCents      Int       @default(0)
  giftCard1Cents Int       @default(0)
  giftCard1Code  String?   @db.VarChar(40)
  giftCard2Cents Int       @default(0)
  giftCard2Code  String?   @db.VarChar(40)
  // Discount on each gift card (0–100 %). The card's amount above is what
  // was entered; only the discounted part counts towards totalCents.
  giftCard1Percent Int     @default(0)
  giftCard2Percent Int     @default(0)
  // The staff member's own tip — not salon income, so not in totalCents.
  tipCents       Int       @default(0)
  totalCents     Int
  note           String?   @db.VarChar(500)
  // PENDING until the owner approves it, then APPROVED (locked for staff),
  // or REJECTED with the owner's reason — the staff member fixes it and
  // sends it again, which puts it back to PENDING.
  status         String    @default("PENDING") @db.VarChar(12)
  reportedById   String
  approvedAt     DateTime?
  approvedById   String?
  ownerNote      String?   @db.VarChar(500)
  rejectedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  photos StaffIncomePhoto[]

  @@index([businessId, status])
  @@index([businessId, serviceAt])
  @@index([staffId, serviceAt])
}

// A photo attached to an income report (receipt, card terminal slip…),
// stored in the database like BusinessImage since the host wipes disk files
// on every deploy.
model StaffIncomePhoto {
  id        String            @id @default(cuid())
  reportId  String
  report    StaffIncomeReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String            @db.VarChar(40)
  createdAt DateTime          @default(now())

  @@index([reportId])
}
