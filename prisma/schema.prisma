// VaraaAi.Com — multi-vendor appointment booking marketplace
// Database: MySQL (Hostinger Cloud Hosting)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────
// Auth
// ────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  BUSINESS_OWNER
  STAFF
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  // Set while an email change is awaiting confirmation — `email` itself
  // stays the old, working address until the new one is verified (see
  // /api/auth/change-email and /api/auth/verify-email).
  pendingEmail  String?
  image         String?
  password      String? // null when the user only signs in via OAuth
  phone         String?
  role          UserRole  @default(CUSTOMER)
  locale        String    @default("vi")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  businesses   Business[] // one or more branches when role = BUSINESS_OWNER
  staffProfile Staff? // present when role = STAFF
  bookings     Booking[]
  reviews      Review[]
  conversations   Conversation[]
  messages        Message[]
  businessFollows BusinessFollow[]
  postComments    PostComment[]

  // Announcements posted after this moment count as "unread" for a salon
  // owner — see Announcement below.
  announcementsSeenAt DateTime?
  supportThread       SupportThread?

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ────────────────────────────────────────────────────────────────────
// Marketplace: businesses, categories, services, staff, availability
// ────────────────────────────────────────────────────────────────────

enum BusinessStatus {
  PENDING // awaiting admin approval
  APPROVED
  REJECTED
  SUSPENDED
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameVi    String
  nameEn    String
  icon      String? // lucide-react icon name
  createdAt DateTime @default(now())

  businesses BusinessCategory[]
  services   Service[]
}

model Business {
  id          String         @id @default(cuid())
  // Not unique: one owner account can run several branches (Business rows) —
  // the dashboard switches between them via the `varaaai_business` cookie.
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug        String         @unique
  name        String
  description String?        @db.Text
  logoUrl     String?
  coverUrl    String?
  status      BusinessStatus @default(PENDING)
  rejectReason String?       @db.Text

  addressLine String?
  city        String?
  country     String  @default("VN")
  lat         Float?
  lng         Float?
  phone       String?
  email       String?
  website     String?
  facebookUrl   String?
  instagramUrl  String?
  tiktokUrl     String?
  youtubeUrl    String? // channel link, shown as an icon
  introVideoUrl String? // a single YouTube video customers can watch inline to preview the salon
  googleMapsUrl String?
  whatsapp      String? // phone number in international format, used for a wa.me link

  timezone String @default("Asia/Ho_Chi_Minh")

  // The language/currency this salon's own customers should see by default
  // (e.g. the embed widget's default locale) — distinct from the viewing
  // customer's own site-wide language preference.
  defaultLocale   String @default("vi")
  defaultCurrency String @default("VND")

  // How many hours before the appointment a CUSTOMER can still self-cancel;
  // past that, only the business can cancel from their own dashboard.
  cancellationWindowHours Int @default(24)
  // Free-text policy shown to the customer after booking and included in
  // their confirmation email — distinct from cancellationWindowHours, which
  // only drives the self-cancel cutoff, not what's actually printed.
  cancellationPolicy String? @db.Text

  // Where customers send money for the "bank transfer" payment method —
  // no automatic reconciliation, same trust model as pay-at-salon cash.
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  bankBic           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  approvedAt DateTime?

  categories BusinessCategory[]
  services   Service[]
  serviceGroups ServiceGroup[]
  landingPage LandingPage?
  staff      Staff[]
  bookings   Booking[]
  reviews    Review[]
  hours      BusinessHours[]
  closures   BusinessClosure[]
  addOns     ServiceAddOn[]
  images     BusinessImage[]
  conversations Conversation[]
  followers     BusinessFollow[]
  posts         Post[]

  @@index([ownerId])
  @@index([status])
  @@index([city])
}

model BusinessCategory {
  businessId String
  categoryId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
}

// Regular weekly opening hours, e.g. Monday 09:00–18:00
model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekday    Int // 0 = Sunday … 6 = Saturday
  openMinute Int // minutes since midnight, e.g. 540 = 09:00
  closeMinute Int // e.g. 1080 = 18:00

  @@index([businessId])
}

// One-off closures / holidays that override BusinessHours for a specific date
model BusinessClosure {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  reason     String?

  @@unique([businessId, date])
}

model Staff {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  title      String?
  bio        String?  @db.Text
  avatarUrl  String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Optional login for this staff member — null means they're just a
  // schedulable name with no dashboard access of their own. Permissions
  // below only gate the "view-only" dashboard sections; Staff management
  // and Settings always stay owner-only regardless of these flags.
  userId            String?  @unique
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  canViewServices   Boolean  @default(false)
  canViewBookings   Boolean  @default(true)
  canViewCustomers  Boolean  @default(false)
  canViewHours      Boolean  @default(false)
  canViewReviews    Boolean  @default(false)
  // Separate from canViewBookings — a staff member can see the bookings
  // calendar without seeing customers' phone/email on each booking unless
  // this is also granted.
  canViewCustomerContactInfo Boolean @default(false)

  // Minutes of advance notice a customer must give to book this staff member
  // (0, 15, 30, 60, 120, 180, 360, 720) — gives them time to prepare, on top
  // of the platform's own minimum lead time.
  leadTimeMinutes Int     @default(0)
  // Shown to the customer when they pick this staff member while booking,
  // and included in their confirmation email.
  staffMessage    String? @db.Text
  // Up to 5 YouTube links to past work, shown as "watch" buttons next to
  // this staff member on the booking page.
  videoUrls       Json?

  services StaffService[]
  bookings Booking[]
  timeOff  StaffTimeOff[]
  hours    StaffHours[]
  avatar   StaffAvatar?

  @@index([businessId])
}

// Kept off the Staff row itself, same reasoning as BusinessImage/LandingImage
// — ordinary staff queries (the dashboard list, booking dropdowns) never pull
// a multi-MB blob along for the ride.
model StaffAvatar {
  id        String   @id @default(cuid())
  staffId   String   @unique
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt
}

// Per-staff weekly schedule. A staff member with zero rows here just follows
// the business's own hours (BusinessHours) — this is opt-in customization,
// not a required setup step for every staff member.
model StaffHours {
  id          String @id @default(cuid())
  staffId     String
  staff       Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday     Int // 0 = Sunday … 6 = Saturday
  openMinute  Int
  closeMinute Int

  @@index([staffId])
}

// Staff-specific time off (vacation, sick day) blocking bookings
model StaffTimeOff {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  reason    String?

  @@index([staffId])
}

// A salon's own section headings for its service menu ("Nails", "Lash
// extensions"...), shown as grouped sections on the public page and the
// services dashboard — distinct from the platform-wide Category, which
// only drives search.
model ServiceGroup {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  services Service[]

  @@index([businessId])
}

model Service {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  groupId      String?
  group        ServiceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  name         String
  description  String?  @db.Text
  durationMin  Int // e.g. 60
  bufferMin    Int      @default(0) // cleanup/prep time added after the appointment
  priceCents   Int // stored in the smallest currency unit
  currency     String   @default("VND")
  depositCents Int? // optional required deposit to confirm a booking
  videoUrl     String? // YouTube preview clip shown next to the service
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff        StaffService[]
  bookings     Booking[]
  addOns       ServiceAddOnLink[]
  bookingExtra BookingExtraService[]

  @@index([businessId])
  @@index([categoryId])
  @@index([groupId])
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // Null means "use the service's own price/duration" — set only when this
  // staff member charges or takes a different amount of time for it.
  priceCentsOverride  Int?
  durationMinOverride Int?

  @@id([staffId, serviceId])
}

// Optional extras a customer can add on top of a main service (e.g. a
// "gloss treatment" add-on next to a haircut) — a business-wide catalog,
// each item opted into per service via ServiceAddOnLink.
model ServiceAddOn {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  priceCents  Int
  durationMin Int      @default(0) // extra minutes tacked onto the appointment
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  services      ServiceAddOnLink[]
  bookingAddOns BookingAddOn[]

  @@index([businessId])
}

model ServiceAddOnLink {
  serviceId String
  addOnId   String
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  addOn     ServiceAddOn @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([serviceId, addOnId])
}

enum ImageKind {
  LOGO
  COVER
}

// Logo/cover bytes live in the DB, not on disk — Hostinger's git-based
// deploy recreates the app directory from scratch on every push, which
// silently wiped anything written to public/uploads at runtime. Kept off
// the Business row itself (a separate model) so ordinary Business queries
// never pull multi-MB blobs along for the ride.
model BusinessImage {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       ImageKind
  data       Bytes
  mimeType   String
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, kind])
}

// ────────────────────────────────────────────────────────────────────
// Bookings, payments, reviews
// ────────────────────────────────────────────────────────────────────

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Booking {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service       @relation(fields: [serviceId], references: [id])
  staffId    String?
  staff      Staff?        @relation(fields: [staffId], references: [id])
  customerId String
  customer   User          @relation(fields: [customerId], references: [id])

  startsAt   DateTime
  endsAt     DateTime
  status     BookingStatus @default(PENDING_PAYMENT)

  priceCents   Int
  depositCents Int?
  currency     String @default("VND")

  customerNote String? @db.Text
  cancelReason String? @db.Text

  // Always true for a customer's own booking (confirmation/reminder emails
  // are the whole point). For a booking the salon adds manually from the
  // calendar, the owner opts in via a checkbox — off by default, since a
  // manually-added walk-in/phone booking usually doesn't need automated
  // email traffic. Gates every email tied to this booking: confirmation,
  // reschedule, cancellation, and the reminder/review cron.
  notificationEmailsEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set the moment each automated email actually goes out — the cron job at
  // /api/cron/reminders reads these as an idempotency guard (never send the
  // same reminder twice) rather than relying on a narrow time window, so it
  // stays correct no matter how often that job actually runs. Cleared back
  // to null on reschedule so a moved booking gets fresh reminders for its
  // new time — see /api/business/bookings/[id]/reschedule.
  reminder24hSentAt   DateTime?
  reminder2hSentAt    DateTime?
  reminder15minSentAt DateTime?
  reviewRequestSentAt DateTime?

  payment       Payment?
  review        Review?
  addOns        BookingAddOn[]
  extraServices BookingExtraService[]

  @@index([businessId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId])
  @@index([status])
}

enum PaymentProvider {
  STRIPE
  VNPAY
  MOMO
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id          String          @id @default(cuid())
  bookingId   String          @unique
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider    PaymentProvider
  status      PaymentStatus   @default(PENDING)
  amountCents Int
  currency    String          @default("VND")
  providerRef String? // Stripe session/intent id, VNPay TxnRef, MoMo orderId
  rawResponse String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([provider, providerRef])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  rating     Int // 1–5
  comment    String?  @db.Text
  ownerReply String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// Add-ons selected for a specific booking. Name/price/duration are snapshot
// at booking time so a later price change to the catalog item never rewrites
// history — addOnId is nullable so deleting a catalog item doesn't touch it.
model BookingAddOn {
  id          String        @id @default(cuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId     String?
  addOn       ServiceAddOn? @relation(fields: [addOnId], references: [id], onDelete: SetNull)
  name        String
  priceCents  Int
  durationMin Int

  @@index([bookingId])
}

// A second (third, fourth...) full service booked in the same visit — e.g.
// a manicure booked alongside a pedicure — as opposed to a BookingAddOn,
// which is a small catalog extra tied to one specific service. Snapshot for
// the same reason as BookingAddOn: history shouldn't move if the service's
// price changes later, and serviceId is nullable so deleting the service
// doesn't touch past bookings.
model BookingExtraService {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name        String
  priceCents  Int
  durationMin Int

  @@index([bookingId])
}

// ────────────────────────────────────────────────────────────────────
// Chat & following
// ────────────────────────────────────────────────────────────────────

// One thread per (business, customer) pair — messages flow both ways
// through it, whether typed by the customer or by the owner/staff replying
// from the dashboard.
model Conversation {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages Message[]

  @@unique([businessId, customerId])
  @@index([customerId])
}

enum MessageSenderType {
  CUSTOMER
  BUSINESS
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     MessageSenderType
  senderId       String
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String?           @db.Text
  // Image bytes live on the row itself, same reasoning as BusinessImage —
  // Hostinger's git-based deploy wipes anything written to public/uploads.
  imageData      Bytes?            @db.LongBlob
  imageMimeType  String?
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

// A customer following a business, for their own reference (e.g. a future
// "salons you follow" list) — distinct from having booked there before.
model BusinessFollow {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([businessId, customerId])
  @@index([customerId])
}

// ────────────────────────────────────────────────────────────────────
// Fanpage — a business's own feed of posts, shown to customers who follow
// them (see BusinessFollow above).
// ────────────────────────────────────────────────────────────────────

model Post {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  content    String?  @db.Text
  // A single YouTube link, same pattern as Business.introVideoUrl and the
  // staff portfolio videos — no self-hosted video, ever.
  videoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  images   PostImage[]
  comments PostComment[]

  @@index([businessId, createdAt])
}

model PostImage {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Bytes live on the row itself, same reasoning as BusinessImage/Message —
  // Hostinger's git-based deploy wipes anything written to public/uploads.
  imageData     Bytes  @db.LongBlob
  imageMimeType String

  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

// ────────────────────────────────────────────────────────────────────
// Support hub for salon owners — training links, announcements from the
// admin, and a direct chat with the admin team.
// ────────────────────────────────────────────────────────────────────

// A how-to video/page the admin publishes for every salon owner.
model TrainingResource {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  url         String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// A notice the admin broadcasts to every salon owner.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// One support conversation per salon-owner account (not per branch).
model SupportThread {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(cuid())
  threadId  String
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromAdmin Boolean
  content   String        @db.Text
  // Set once the other side has opened the thread and seen this message.
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
}

// ────────────────────────────────────────────────────────────────────
// Landing page — a salon's own publishable marketing page (separate from
// the always-on /b/[slug] booking profile), editable section by section
// like Timma's "Website" builder.
// ────────────────────────────────────────────────────────────────────

model LandingPage {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Hidden from the public until the owner explicitly publishes it.
  published  Boolean  @default(false)

  // Hero — the top section. Layout: "IMAGE_RIGHT" | "IMAGE_LEFT" | "TEXT_ONLY".
  heroLayout       String  @default("IMAGE_RIGHT")
  heroTitle        String?
  heroText         String? @db.Text
  heroButtonLabel  String?
  // "BOOKING" links to the salon's own booking page; "URL" uses heroButtonUrl.
  heroButtonTarget String  @default("BOOKING")
  heroButtonUrl    String?

  // Intro/about — optional second section, same shape as the hero.
  introEnabled      Boolean @default(true)
  introLayout       String  @default("IMAGE_LEFT")
  introTitle        String?
  introText         String? @db.Text
  introButtonLabel  String?
  introButtonTarget String  @default("BOOKING")
  introButtonUrl    String?

  // Highlights — a row of feature cards (see LandingHighlight).
  highlightsEnabled Boolean @default(true)
  highlightsTitle   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     LandingImage[]
  highlights LandingHighlight[]
}

model LandingHighlight {
  id            String      @id @default(cuid())
  landingPageId String
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)
  title         String
  description   String?     @db.Text
  buttonLabel   String?
  buttonTarget  String      @default("BOOKING") // "BOOKING" | "URL"
  buttonUrl     String?

  @@index([landingPageId])
}

// Landing-page images live on the row itself, same reasoning as
// BusinessImage — Hostinger's git-based deploy wipes public/uploads.
// Keyed by a free-form slot ("hero", "intro", or a highlight's own id) so
// an arbitrary number of highlight images don't need their own enum.
model LandingImage {
  id            String      @id @default(cuid())
  landingPageId String
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  slot          String
  data          Bytes
  mimeType      String
  updatedAt     DateTime    @updatedAt

  @@unique([landingPageId, slot])
}
