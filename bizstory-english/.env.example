# Sao chép thành .env (KHÔNG đưa .env lên git). Trên cloud: đặt trong cài đặt môi trường.
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-opus-5-5       # hoặc gpt-... nếu dùng openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MAX11_API_KEY=
KIE_API_KEY=
TTS_MODEL=eleven_flash_v2_5
TTS_WORKERS=4
SLOW_MODE=atempo                # atempo (miễn phí) | tts (11max đọc chậm, tốn thêm credit)
