  "title": "Diện tích hình chữ nhật, diện tích hình vuông",
  "contentRev": 1,
  "theory": {
    "title": "Nhớ nhanh",
    "blocks": [
      {
        "kind": "text",
        "text": "Diện tích hình chữ nhật = chiều dài × chiều rộng (cùng đơn vị đo). Diện tích hình vuông = cạnh × cạnh.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: hình chữ nhật dài 9 cm, rộng 4 cm có diện tích:"
      },
      {
        "kind": "equation",
        "text": "9 × 4 = 36"
      },
      {
        "kind": "text",
        "text": "Vậy diện tích là 36 cm²."
      },
      {
        "kind": "text",
        "text": "Chu vi đo bằng cm, diện tích đo bằng cm² – đừng nhầm nhé!",
        "style": "tip"
      }
    ]
  },
