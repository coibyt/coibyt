      {
        "kind": "text",
        "text": "Tính khoảng thời gian: đếm số phút đến giờ đúng tiếp theo, rồi đếm tiếp phần còn lại. 1 giờ = 60 phút.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Buổi biểu diễn văn nghệ diễn ra từ 10 giờ 55 phút đến 11 giờ 35 phút. Hỏi thời gian đó dài bao nhiêu phút?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Từ 10 giờ 55 phút đến 11 giờ là:",
            "equation": "60 - 55 = 5 (phút)"
          },
          {
            "explanation": "Từ 11 giờ đến 11 giờ 35 phút là 35 phút. Thời gian đó dài là:",
            "equation": "5 + 35 = 40 (phút)"
          }
        ],
        "answer": "Đáp số: 40 phút."
      }
    ]
  },
