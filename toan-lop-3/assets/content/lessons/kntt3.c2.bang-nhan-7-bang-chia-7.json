      {
        "kind": "text",
        "text": "Trong bảng nhân 7, mỗi lần thêm một lần thừa số thì tích tăng thêm đúng số đó. Bảng chia là phép tính ngược của bảng nhân.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Bảng nhân 7: 7 × 1 = 7; 7 × 2 = 14; 7 × 3 = 21; 7 × 4 = 28; 7 × 5 = 35; 7 × 6 = 42; 7 × 7 = 49; 7 × 8 = 56; 7 × 9 = 63; 7 × 10 = 70."
      },
      {
        "kind": "equation",
        "text": "7 × 2 = 14"
      },
      {
        "kind": "equation",
        "text": "14 : 7 = 2"
      },
      {
        "kind": "text",
        "text": "Đếm thêm 7 để nhớ bảng: 7, 14, 21, 28, 35, …",
        "style": "tip"
      }
    ]
  },
