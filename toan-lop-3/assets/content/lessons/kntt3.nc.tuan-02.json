      {
        "kind": "text",
        "text": "Khi dấu ? nằm trong một phép nhân (hoặc chia) và còn thêm phép cộng, trừ, ta coi cả phép nhân (chia) đó là một số chưa biết: tìm nó trước, rồi mới tìm dấu ?.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: tìm số thích hợp thay cho dấu ?: ? × 5 - 26 = 14"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Tìm ? × 5:",
            "equation": "14 + 26 = 40"
          },
          {
            "explanation": "Tìm ?:",
            "equation": "40 : 5 = 8"
          }
        ],
        "answer": "Đáp số: 8."
      }
    ]
  },
