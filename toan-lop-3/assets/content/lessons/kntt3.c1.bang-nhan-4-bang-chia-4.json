    "blocks": [
      {
        "kind": "text",
        "text": "Trong bảng nhân 4, mỗi lần thêm một lần thừa số thì tích tăng thêm đúng số đó. Bảng chia là phép tính ngược của bảng nhân.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Bảng nhân 4: 4 × 1 = 4; 4 × 2 = 8; 4 × 3 = 12; 4 × 4 = 16; 4 × 5 = 20; 4 × 6 = 24; 4 × 7 = 28; 4 × 8 = 32; 4 × 9 = 36; 4 × 10 = 40."
      },
      {
        "kind": "equation",
        "text": "4 × 6 = 24"
      },
      {
        "kind": "equation",
        "text": "24 : 4 = 6"
      },
      {
        "kind": "text",
        "text": "Đếm thêm 4 để nhớ bảng: 4, 8, 12, 16, 20, …",
        "style": "tip"
      }
    ]
  },
