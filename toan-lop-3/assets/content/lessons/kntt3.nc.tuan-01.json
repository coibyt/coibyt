    "blocks": [
      {
        "kind": "text",
        "text": "Bài toán “nghĩ một số”: muốn tìm số ban đầu, ta tính ngược từ kết quả. Phép cộng đổi thành phép trừ, phép trừ đổi thành phép cộng.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Bạn Hùng nghĩ ra một số. Lấy số đó cộng với 248 rồi trừ đi 293 thì được 389. Hỏi bạn Hùng đã nghĩ ra số nào?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Số trước khi trừ đi 293 là:",
            "equation": "389 + 293 = 682"
          },
          {
            "explanation": "Số bạn Hùng đã nghĩ là:",
            "equation": "682 - 248 = 434"
          }
        ],
        "answer": "Đáp số: 434."
      }
    ]
  },
