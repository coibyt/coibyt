    "blocks": [
      {
        "kind": "text",
        "text": "Trong bảng nhân 6, mỗi lần thêm một lần thừa số thì tích tăng thêm đúng số đó. Bảng chia là phép tính ngược của bảng nhân.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Bảng nhân 6: 6 × 1 = 6; 6 × 2 = 12; 6 × 3 = 18; 6 × 4 = 24; 6 × 5 = 30; 6 × 6 = 36; 6 × 7 = 42; 6 × 8 = 48; 6 × 9 = 54; 6 × 10 = 60."
      },
      {
        "kind": "equation",
        "text": "6 × 8 = 48"
      },
      {
        "kind": "equation",
        "text": "48 : 6 = 8"
      },
      {
        "kind": "text",
        "text": "Đếm thêm 6 để nhớ bảng: 6, 12, 18, 24, 30, …",
        "style": "tip"
      }
    ]
  },
