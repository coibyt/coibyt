    "blocks": [
      {
        "kind": "text",
        "text": "1 l = 1.000 ml. Muốn tính với số đo có hai tên đơn vị (như 1 l 250 ml), con đổi hết về mi-li-lít trước.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Bình thứ nhất có 1 l 300 ml nước. Bình thứ hai có ít hơn bình thứ nhất 130 ml nước. Hỏi cả hai bình có bao nhiêu mi-li-lít nước?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Đổi 1 l 300 ml =",
            "equation": "1.000 + 300 = 1.300 (ml)"
          },
          {
            "explanation": "Số nước ở bình thứ hai là:",
            "equation": "1.300 - 130 = 1.170 (ml)"
          },
          {
            "explanation": "Số nước ở cả hai bình là:",
            "equation": "1.300 + 1.170 = 2.470 (ml)"
          }
        ],
        "answer": "Đáp số: 2.470 ml."
      }
    ]
  },
