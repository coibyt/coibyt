    "blocks": [
      {
        "kind": "text",
        "text": "Bài toán “hiệu và gấp”: coi số bé là 1 phần thì số lớn là mấy phần như thế. Lấy hiệu chia cho hiệu số phần để được số bé.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Bạn Khang có nhiều hơn bạn Hoa 16 nhãn vở. Số nhãn vở của Khang gấp 9 lần số nhãn vở của Hoa. Hỏi bạn Hoa có bao nhiêu nhãn vở?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Coi số nhãn vở của Hoa là 1 phần thì số nhãn vở của Khang là 9 phần như thế. Hiệu số phần bằng nhau là:",
            "equation": "9 - 1 = 8 (phần)"
          },
          {
            "explanation": "Số nhãn vở của Hoa là:",
            "equation": "16 : 8 = 2 (nhãn vở)"
          }
        ],
        "answer": "Đáp số: 2 nhãn vở."
      }
    ]
  },
