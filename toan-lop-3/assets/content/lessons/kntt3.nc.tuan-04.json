    "blocks": [
      {
        "kind": "text",
        "text": "Khi bài toán có nhiều bước, con tính lần lượt từng bước; kết quả của bước trước là số đã biết của bước sau.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Mỗi hộp có 7 cái bánh. Mẹ mua 3 hộp bánh, mẹ biếu bà 13 cái, số bánh còn lại mẹ chia đều cho 2 bạn nhỏ. Hỏi mỗi bạn được mấy cái bánh?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Số bánh mẹ mua là:",
            "equation": "7 × 3 = 21 (cái)"
          },
          {
            "explanation": "Số bánh còn lại là:",
            "equation": "21 - 13 = 8 (cái)"
          },
          {
            "explanation": "Số bánh mỗi bạn được là:",
            "equation": "8 : 2 = 4 (cái)"
          }
        ],
        "answer": "Đáp số: 4 cái bánh."
      }
    ]
  },
