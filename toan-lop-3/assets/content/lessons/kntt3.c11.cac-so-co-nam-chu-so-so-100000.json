  "theory": {
    "title": "Nhớ nhanh",
    "blocks": [
      {
        "kind": "text",
        "text": "Số có 5 chữ số gồm các hàng: chục nghìn, nghìn, trăm, chục, đơn vị. Đọc và viết số từ hàng cao nhất đến hàng đơn vị.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: 20.224 đọc là “hai mươi nghìn hai trăm hai mươi tư”."
      },
      {
        "kind": "equation",
        "text": "20.224 = 20.000 + 200 + 20 + 4"
      },
      {
        "kind": "text",
        "text": "Chữ số 0 ở hàng trăm đọc là “không trăm”, ở hàng chục (khi hàng đơn vị khác 0) đọc là “linh”.",
        "style": "tip"
      }
    ]
  },
