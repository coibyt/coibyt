  "theory": {
    "title": "Nhớ nhanh",
    "blocks": [
      {
        "kind": "text",
        "text": "Khi làm tròn số đến một hàng, ta nhìn chữ số ở hàng ngay bên phải: nếu bé hơn 5 thì làm tròn xuống, nếu lớn hơn hoặc bằng 5 thì làm tròn lên.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: làm tròn 26.550 đến hàng nghìn."
      },
      {
        "kind": "text",
        "text": "Chữ số hàng trăm của 26.550 là 5, lớn hơn hoặc bằng 5 nên làm tròn lên."
      },
      {
        "kind": "text",
        "text": "Làm tròn 26.550 đến hàng nghìn được 27.000."
      },
      {
        "kind": "text",
        "text": "Làm tròn số giúp ta nói gần đúng một số đo, ví dụ “khoảng 2.000 người”.",
        "style": "tip"
      }
    ]
  },
