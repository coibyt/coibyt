      {
        "kind": "text",
        "text": "Số có 4 chữ số gồm các hàng: nghìn, trăm, chục, đơn vị. Đọc và viết số từ hàng cao nhất đến hàng đơn vị.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: 5.005 đọc là “năm nghìn không trăm linh năm”."
      },
      {
        "kind": "equation",
        "text": "5.005 = 5.000 + 5"
      },
      {
        "kind": "text",
        "text": "Chữ số 0 ở hàng trăm đọc là “không trăm”, ở hàng chục (khi hàng đơn vị khác 0) đọc là “linh”.",
        "style": "tip"
      }
    ]
  },
