  "title": "Ôn tập bảng nhân 2, 5, bảng chia 2, 5",
  "contentRev": 1,
  "theory": {
    "title": "Nhớ nhanh",
    "blocks": [
      {
        "kind": "text",
        "text": "Trong bảng nhân 2, 5, mỗi lần thêm một lần thừa số thì tích tăng thêm đúng số đó. Bảng chia là phép tính ngược của bảng nhân.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Bảng nhân 2: 2 × 1 = 2; 2 × 2 = 4; 2 × 3 = 6; 2 × 4 = 8; 2 × 5 = 10; 2 × 6 = 12; 2 × 7 = 14; 2 × 8 = 16; 2 × 9 = 18; 2 × 10 = 20."
      },
      {
        "kind": "text",
        "text": "Bảng nhân 5: 5 × 1 = 5; 5 × 2 = 10; 5 × 3 = 15; 5 × 4 = 20; 5 × 5 = 25; 5 × 6 = 30; 5 × 7 = 35; 5 × 8 = 40; 5 × 9 = 45; 5 × 10 = 50."
      },
      {
        "kind": "equation",
        "text": "5 × 5 = 25"
      },
      {
        "kind": "text",
        "text": "Đếm thêm 5 để nhớ bảng: 5, 10, 15, 20, 25, …",
        "style": "tip"
      }
    ]
  },
