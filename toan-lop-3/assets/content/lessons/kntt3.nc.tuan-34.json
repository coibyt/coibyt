    "blocks": [
      {
        "kind": "text",
        "text": "Muốn “chắc chắn” lấy được viên bi màu cần lấy, con nghĩ đến lúc không may nhất: lấy hết các viên bi màu khác trước.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Trong một hộp kín có 5 viên bi xanh, 7 viên bi vàng và 9 viên bi đỏ. Không nhìn vào hộp, phải lấy ra ít nhất bao nhiêu viên bi để chắc chắn có ít nhất 1 viên bi đỏ?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Lúc không may nhất, ta lấy ra hết số bi không phải màu đỏ:",
            "equation": "5 + 7 = 12 (viên)"
          },
          {
            "explanation": "Lấy thêm 1 viên nữa thì chắc chắn có 1 viên bi đỏ. Số bi ít nhất phải lấy là:",
            "equation": "12 + 1 = 13 (viên)"
          }
        ],
        "answer": "Đáp số: 13 viên bi."
      }
    ]
  },
