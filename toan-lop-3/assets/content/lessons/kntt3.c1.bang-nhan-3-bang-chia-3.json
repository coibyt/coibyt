    "blocks": [
      {
        "kind": "text",
        "text": "Trong bảng nhân 3, mỗi lần thêm một lần thừa số thì tích tăng thêm đúng số đó. Bảng chia là phép tính ngược của bảng nhân.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Bảng nhân 3: 3 × 1 = 3; 3 × 2 = 6; 3 × 3 = 9; 3 × 4 = 12; 3 × 5 = 15; 3 × 6 = 18; 3 × 7 = 21; 3 × 8 = 24; 3 × 9 = 27; 3 × 10 = 30."
      },
      {
        "kind": "equation",
        "text": "3 × 3 = 9"
      },
      {
        "kind": "equation",
        "text": "9 : 3 = 3"
      },
      {
        "kind": "text",
        "text": "Đếm thêm 3 để nhớ bảng: 3, 6, 9, 12, 15, …",
        "style": "tip"
      }
    ]
  },
