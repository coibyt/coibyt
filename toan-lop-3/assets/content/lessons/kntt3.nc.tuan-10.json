  "contentRev": 1,
  "theory": {
    "title": "Bí kíp nâng cao",
    "blocks": [
      {
        "kind": "text",
        "text": "Bài toán “tổng và gấp”: coi số bé là 1 phần thì số lớn là mấy phần như thế. Lấy tổng chia cho tổng số phần để được số bé.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Hai thùng có tất cả 27 l nước. Thùng to có số nước gấp 8 lần thùng nhỏ. Hỏi thùng to có bao nhiêu lít nước?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Coi số nước ở thùng nhỏ là 1 phần thì số nước ở thùng to là 8 phần như thế. Tổng số phần bằng nhau là:",
            "equation": "1 + 8 = 9 (phần)"
          },
          {
            "explanation": "Giá trị của một phần (số nước ở thùng nhỏ) là:",
            "equation": "27 : 9 = 3 (l)"
          },
          {
            "explanation": "Số nước ở thùng to là:",
            "equation": "3 × 8 = 24 (l)"
          }
        ],
        "answer": "Đáp số: 24 l nước."
      }
    ]
  },
