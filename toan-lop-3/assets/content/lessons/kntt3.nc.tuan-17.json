    "blocks": [
      {
        "kind": "text",
        "text": "Muốn biết số lớn gấp mấy lần số bé, ta lấy số lớn chia cho số bé. Nếu đề chưa cho số lớn, con tìm số lớn trước.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: Dũng có 4 bông hoa. Mai có nhiều hơn Dũng 20 bông hoa. Hỏi số hoa của Mai gấp mấy lần số hoa của Dũng?"
      },
      {
        "kind": "word_problem",
        "lines": [
          {
            "explanation": "Số hoa của Mai là:",
            "equation": "4 + 20 = 24 (bông)"
          },
          {
            "explanation": "Số hoa của Mai gấp số hoa của Dũng số lần là:",
            "equation": "24 : 4 = 6 (lần)"
          }
        ],
        "answer": "Đáp số: 6 lần."
      }
    ]
  },
