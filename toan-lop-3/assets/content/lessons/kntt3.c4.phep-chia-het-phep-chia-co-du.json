      {
        "kind": "long_division",
        "dividend": "14",
        "divisor": "5",
        "quotient": "2",
        "remainder": 4,
        "digitSteps": [
          {
            "text": "14 chia 5 được 2, viết 2. 2 nhân 5 bằng 10; 14 trừ 10 bằng 4.",
            "partialDividend": 14,
            "quotientDigit": 2,
            "product": 10,
            "remainder": 4
          }
        ]
      },
      {
        "kind": "text",
        "text": "Thử lại:"
      },
      {
        "kind": "equation",
        "text": "2 × 5 + 4 = 14"
      }
    ]
