    "blocks": [
      {
        "kind": "text",
        "text": "Tiền Việt Nam có các tờ 1.000, 2.000, 5.000, 10.000, 20.000, 50.000, 100.000 đồng. Muốn biết có bao nhiêu tiền, ta cộng giá trị các tờ tiền.",
        "style": "rule"
      },
      {
        "kind": "text",
        "text": "Ví dụ: 2 tờ 10.000 đồng và 1 tờ 5.000 đồng là:"
      },
      {
        "kind": "equation",
        "text": "10.000 × 2 + 5.000 = 25.000"
      },
      {
        "kind": "text",
        "text": "Vậy có 25.000 đồng."
      },
      {
        "kind": "text",
        "text": "Mua hàng: tiền trả lại = tiền đưa – giá tiền món hàng.",
        "style": "tip"
      }
    ]
  },
